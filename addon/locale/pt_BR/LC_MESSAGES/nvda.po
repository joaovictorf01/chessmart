msgstr "Nível de desafio"

#: addon/globalPlugins/chessmart/graphical_interface/new_game_dialog.py:284
msgid "Challenge whom?"
msgstr "Desafiar quem?"

#. Part of the session description, e.g. "Challenge: Balanced".
#: addon/globalPlugins/chessmart/puzzle_database/__init__.py:290
msgid "Challenge: {level}"
msgstr "Desafio: {level}"

#. Name of the online chat list.
#: addon/globalPlugins/chessmart/virtual_chessboard/internet_chessboard.py:44
#: addon/globalPlugins/chessmart/virtual_chessboard/internet_chessboard.py:95
msgid "Chat"
