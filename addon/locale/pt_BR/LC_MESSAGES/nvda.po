#: addon/globalPlugins/chessmart/virtual_chessboard/internet_chessboard.py:43
msgid "Enter chat message"
msgstr "Digite a mensagem do bate-papo"

#: addon/globalPlugins/chessmart/graphical_interface/new_game_dialog.py:283
msgid "Enter the user name of the user you want to challenge:"
msgstr "Digite o nome do usuário que quer desafiar:"

#: addon/globalPlugins/chessmart/graphical_interface/new_game_dialog.py:330
msgid "Error"
msgstr "Erro"

#: addon/globalPlugins/chessmart/graphical_interface/new_game_dialog.py:322
msgid "Failed to connect to lichess.org. Please try again later."
msgstr "Falha ao conectar ao lichess.org. Tente de novo mais tarde."

#. Spoken when an online chat message could not be sent.
#: addon/globalPlugins/chessmart/virtual_chessboard/internet_chessboard.py:80
msgid "Failed to send chat message"
msgstr "Falha ao enviar a mensagem do bate-papo"

#: addon/globalPlugins/chessmart/virtual_chessboard/internet_chessboard.py:117
msgid "Failed to send move"
msgstr "Falha ao enviar o lance"

#. Description of the easiest challenge level.
#: addon/globalPlugins/chessmart/trainer.py:303
msgid "Favor shorter, cleaner and more popular examples."
msgstr "Prefere exemplos mais curtos, limpos e populares."

#: addon/globalPlugins/chessmart/virtual_chessboard/puzzle_board.py:764
msgid "Filters: {filters}."
msgstr "Filtros: {filters}."

#. Description of the training plan about attacking the king.
#: addon/globalPlugins/chessmart/trainer.py:271
msgid "Focus on mating nets and direct attacking play."
msgstr "Foco em redes de mate e ataque direto."

#. Description of the challenge level that follows the user's rating.
#: addon/globalPlugins/chessmart/trainer.py:327
msgid "Follows your tactics rating: the difficulty tracks you as you improve."
msgstr ""
"Segue o seu rating de táticas: a dificuldade acompanha você conforme "
"melhora."

#: addon/globalPlugins/chessmart/virtual_chessboard/puzzle_board.py:535
msgid "from {count} rated attempts"
msgstr "em {count} tentativas valendo rating"

#. Origin of a move, spoken after the piece, e.g. "from g1".
#: addon/globalPlugins/chessmart/spoken_messages.py:127
msgid "from {square}"
msgstr "de {square}"

#. Window title when the game ended in a draw.
#: addon/globalPlugins/chessmart/virtual_chessboard/base.py:388
msgid "Game Drawn"
msgstr "Partida empatada"

#. Result of a PGN game.
#: addon/globalPlugins/chessmart/virtual_chessboard/pgn_player.py:80
msgid "Game ended in a draw"
msgstr "Partida terminou empatada"

#. Spoken when the game ended in a draw.
#: addon/globalPlugins/chessmart/virtual_chessboard/base.py:394
msgid "Game is drawn"
msgstr "Partida empatada"

#. Result of a PGN game that has no result yet.
#: addon/globalPlugins/chessmart/virtual_chessboard/pgn_player.py:70
msgid "Game not finished"
msgstr "Partida não terminada"

#. Window title when a game has ended.
#: addon/globalPlugins/chessmart/virtual_chessboard/base.py:367
msgid "Game Over"
msgstr "Fim de partida"

#. Window title when a game was lost on time, e.g. "Game Over: Time Forfeit -
#. white is the winner".
#: addon/globalPlugins/chessmart/virtual_chessboard/base.py:401
msgid "Game Over: Time Forfeit - {color} is the winner"
msgstr "Fim de partida: derrota por tempo - {color} venceram"

#. Window title and message when a game stopped because of an error.
#: addon/globalPlugins/chessmart/virtual_chessboard/base.py:419
msgid "Game terminated due to an error"
msgstr "Partida encerrada por um erro"

#: addon/globalPlugins/chessmart/virtual_chessboard/puzzle_board.py:590
msgid "Goal: find the best continuation for {color}."
msgstr "Objetivo: encontre a melhor continuação para as {color}."

#: addon/globalPlugins/chessmart/virtual_chessboard/puzzle_board.py:399
msgid "Good move."
msgstr "Bom lance."

#. Name of the beginner training plan.
#: addon/globalPlugins/chessmart/trainer.py:253
msgid "Guided basics"
msgstr "Fundamentos guiados"

#: addon/globalPlugins/chessmart/virtual_chessboard/puzzle_board.py:161
msgid "Hint"
msgstr "Dica"

#: addon/globalPlugins/chessmart/virtual_chessboard/puzzle_board.py:658
msgid "Hint: the move ends on {square}."
msgstr "Dica: o lance termina em {square}."

#: addon/globalPlugins/chessmart/virtual_chessboard/puzzle_board.py:655
msgid "Hint: the move starts from {square}."
msgstr "Dica: o lance começa em {square}."

#: addon/globalPlugins/chessmart/virtual_chessboard/puzzle_board.py:649
