#: addon/globalPlugins/chessmart/graphical_interface/download_dialog.py:148
msgid ""
"Could not reach the download server. Check your internet connection and try "
"again."
msgstr ""
"Não foi possível alcançar o servidor de download. Verifique sua conexão com "
"a internet e tente de novo."

#. Spoken when saving is refused because NVDA runs in secure mode.
#: addon/globalPlugins/chessmart/virtual_chessboard/base.py:225
#: addon/globalPlugins/chessmart/virtual_chessboard/base.py:231
