#: addon/globalPlugins/chessmart/theme_names.py:280
msgid "Vukovic mate"
msgstr "Mate de Vukovic"

#. Name of the training plan about winning material, shown in a combo box.
#: addon/globalPlugins/chessmart/trainer.py:86
msgid "Win material: forks, pins, skewers and defenders"
msgstr "Ganhar material: garfos, cravadas, espetos e defensores"

#. Name of a puzzle theme.
#: addon/globalPlugins/chessmart/theme_names.py:284
msgid "X-ray attack"
msgstr "Ataque raio-x"

#. Name of a puzzle theme.
#: addon/globalPlugins/chessmart/theme_names.py:286
msgid "Zugzwang"
msgstr "Zugzwang"

#. One theme in the picker. {label} is its name, {description} what it means,
#: addon/globalPlugins/chessmart/graphical_interface/tactics_setup.py:365
msgid "{label}: {description} ({count:,} puzzles)"
msgstr "{label}: {description} ({count:,} puzzles)"

#. One challenge level in the combo box, e.g. "Intermediate: puzzles rated 900
#. to 1500".
#: addon/globalPlugins/chessmart/trainer.py:290
msgid "{name}: {rating_range}"
msgstr "{name}: {rating_range}"

#. Spoken when jumping to a piece that is no longer on the board, e.g. "No
#. white knight".
#: addon/globalPlugins/chessmart/virtual_chessboard/base.py:583
msgid "No {piece}"
msgstr "Sem {piece}"

#. Summary of the training setup: plan, level and themes, one per line.
#: addon/globalPlugins/chessmart/graphical_interface/tactics_setup.py:258
msgid ""
"{plan}. {plan_desc}\n"
"{challenge}. {challenge_desc}\n"
"{theme_text} Minimum popularity {min_popularity}."
msgstr ""
"{plan}. {plan_desc}\n"
"{challenge}. {challenge_desc}\n"
"{theme_text} Popularidade mínima {min_popularity}."

#. Asked when Escape is pressed during a game against the engine.
#: addon/globalPlugins/chessmart/virtual_chessboard/user_engine.py:74
msgid "Leave the game? The game against the engine will be abandoned."
msgstr "Sair da partida? A partida contra a engine será abandonada."

#. Asked when Escape is pressed during a game between two people at the
#. keyboard.
#: addon/globalPlugins/chessmart/virtual_chessboard/user_driven.py:138
msgid "Leave the game? The moves played so far will be lost."
msgstr "Sair da partida? Os lances jogados até aqui serão perdidos."

#. Asked when Escape is pressed during a puzzle the player has already started
#. solving.
#: addon/globalPlugins/chessmart/virtual_chessboard/puzzle_board.py:158
msgid "Leave training? The current puzzle will count as unsolved."
msgstr "Sair do treino? O puzzle atual vai contar como não resolvido."

#. Asked when Escape is pressed during tactics training.
#: addon/globalPlugins/chessmart/virtual_chessboard/puzzle_board.py:160
msgid "Leave training? The session status will be lost."
msgstr "Sair do treino? O status da sessão será perdido."

#. Option in the menu shown when Escape is pressed during a game.
#: addon/globalPlugins/chessmart/virtual_chessboard/base.py:315
msgid "No, keep playing"
msgstr "Não, continuar jogando"

#. Option in the menu shown when Escape is pressed during a game.
#: addon/globalPlugins/chessmart/virtual_chessboard/base.py:317
msgid "Yes, leave"
msgstr "Sim, sair"

#. Menu item that opens the endgame drills.
#: addon/globalPlugins/chessmart/__init__.py:66
msgid "&Endgames..."
msgstr "&Finais..."

#. What to do in the queen against king drill.
#: addon/globalPlugins/chessmart/endgame/drills.py:57
msgid ""
"Checkmate in under 10 moves. The queen alone cannot mate: drive the king to "
"the edge, bring your own king up, and mind the stalemate."
msgstr ""
"Mate em menos de 10 lances. A dama sozinha não dá mate: leve o rei "
"adversário à borda, suba o seu rei e cuidado com o afogamento."

#. What to do in the rook against king drill.
#: addon/globalPlugins/chessmart/endgame/drills.py:69
msgid ""
"Checkmate in under 20 moves. Keep your king on the same rank or file as the "
"other king, next to the rook, and push the king to the edge."
msgstr ""
"Mate em menos de 20 lances. Mantenha o seu rei na mesma fileira ou coluna do"
" rei adversário, ao lado da torre, e empurre o rei para a borda."

#. Spoken when the drill ends in checkmate; {moves} is a number.
#: addon/globalPlugins/chessmart/endgame/drills.py:243
msgid "Checkmate in {moves} moves."
msgstr "Mate em {moves} lances."

#. Spoken when an endgame drill ends. Spoken when the player runs out of time
#. in an endgame drill.
#: addon/globalPlugins/chessmart/virtual_chessboard/endgame_board.py:328
#: addon/globalPlugins/chessmart/virtual_chessboard/endgame_board.py:339
msgid "Control+N opens another position."
msgstr "Control+N abre outra posição."

#. Spoken when the drill ends in a draw that is not stalemate.
#: addon/globalPlugins/chessmart/endgame/drills.py:260
msgid "Draw. The position was won."
msgstr "Empate. A posição estava ganha."

#. Title of the endgames dialog.
#: addon/globalPlugins/chessmart/graphical_interface/endgame_dialog.py:30
msgid "Endgames"
msgstr "Finais"

#. Name of the endgame drill with king and pawn against king.
#: addon/globalPlugins/chessmart/endgame/drills.py:118
msgid "King and pawn against king"
msgstr "Rei e peão contra rei"

#. Asked when Escape is pressed during an endgame drill.
#: addon/globalPlugins/chessmart/virtual_chessboard/endgame_board.py:275
msgid "Leave the drill? The position will be lost."
msgstr "Sair do treino? A posição será perdida."

#. Menu item that opens the endgame drills.
#: addon/globalPlugins/chessmart/__init__.py:67
msgid "Practice elementary endgames against the engine"
msgstr "Treinar finais elementares contra a engine"

#. What to do in the king and pawn drill.
#: addon/globalPlugins/chessmart/endgame/drills.py:120
msgid ""
"Promote the pawn and checkmate. The king goes in front of the pawn and takes"
" the opposition; the pawn moves last."
msgstr ""
"Coroe o peão e dê mate. O rei vai na frente do peão e toma a oposição; o "
"peão anda por último."

#. Name of the endgame drill with queen and king against king.
#: addon/globalPlugins/chessmart/endgame/drills.py:55
msgid "Queen and king against king"
msgstr "Dama e rei contra rei"

#. Name of the endgame drill with rook and king against king.
#: addon/globalPlugins/chessmart/endgame/drills.py:67
msgid "Rook and king against king"
msgstr "Torre e rei contra rei"

#. Spoken when the drill ends in stalemate.
#: addon/globalPlugins/chessmart/endgame/drills.py:256
msgid ""
"Stalemate: the black king had no legal move and was not in check. Draw."
msgstr ""
"Afogamento: o rei preto não tinha lance legal e não estava em xeque. Empate."

#. Spoken when the mate took longer than the drill's target.
#: addon/globalPlugins/chessmart/endgame/drills.py:252
msgid "The target was under {target} moves."
msgstr "A meta era menos de {target} lances."

#. Spoken when the player runs out of time in an endgame drill.
#: addon/globalPlugins/chessmart/virtual_chessboard/endgame_board.py:337
msgid ""
"Time over with the position won. The technique is what saves the clock."
msgstr ""
"Tempo esgotado com a posição ganha. A técnica é o que salva o relógio."

#. Spoken when the mate came within the drill's target.
#: addon/globalPlugins/chessmart/endgame/drills.py:248
msgid "Within the target of under {target} moves."
msgstr "Dentro da meta de menos de {target} lances."

#. Spoken at the end of a drill; {seconds} is a number.
#: addon/globalPlugins/chessmart/endgame/drills.py:263
msgid "{seconds} seconds left on the clock."
msgstr "{seconds} segundos no relógio."

#. Name of the first endgame lesson (a drill).
#: addon/globalPlugins/chessmart/endgame/lessons.py:75
msgid "1a. Mate with queen and king"
msgstr "1a. Mate de dama e rei"

#. Name of the second endgame lesson (a drill).
#: addon/globalPlugins/chessmart/endgame/lessons.py:86
msgid "1b. Mate with rook and king"
msgstr "1b. Mate de torre e rei"

#. Name of the endgame lesson on the king and the opposition.
#: addon/globalPlugins/chessmart/endgame/lessons.py:130
msgid "2. The king and the opposition"
msgstr "2. O rei e a oposição"

#. Name of the endgame lesson on king and pawn against king.
#: addon/globalPlugins/chessmart/endgame/lessons.py:214
msgid "3. King and pawn against king"
msgstr "3. Rei e peão contra rei"

#. Name of the endgame lesson on a piece against a pawn.
#: addon/globalPlugins/chessmart/endgame/lessons.py:310
msgid "4. A piece against a pawn"
msgstr "4. Uma peça contra um peão"

#. Name of the endgame lesson on pawns on both sides.
#: addon/globalPlugins/chessmart/endgame/lessons.py:382
msgid "5. Pawns on both sides"
msgstr "5. Peões dos dois lados"

#. Name of the endgame lesson on rook and pawn against rook.
#: addon/globalPlugins/chessmart/endgame/lessons.py:430
msgid "6. Rook and pawn against rook"
msgstr "6. Torre e peão contra torre"

#. Name of the endgame lesson on queen against pawn.
#: addon/globalPlugins/chessmart/endgame/lessons.py:493
msgid "7. Queen against a pawn on the seventh"
msgstr "7. Dama contra peão na sétima"

#. Name of the endgame lesson on bishop and rook pawn.
#: addon/globalPlugins/chessmart/endgame/lessons.py:553
msgid "8. Bishop and rook pawn"
msgstr "8. Bispo e peão de torre"

#. Rule taught by a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:372
msgid ""
"A bishop that reaches the diagonal of the promotion square holds the pawn "
"from any distance. Draw."
msgstr ""
"Um bispo que alcança a diagonal da casa de coroação segura o peão de "
"qualquer distância. Empate."

#. Rule taught by a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:348
msgid ""
"A knight that controls the promotion square holds a seventh-rank pawn on its"
" own: it moves away and comes back, and the pawn cannot pass. Draw."
msgstr ""
"Um cavalo que controla a casa de coroação segura sozinho um peão na sétima: "
"ele sai e volta, e o peão não passa. Empate."

#. Rule taught by a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:180
msgid ""
"A rook pawn is the exception: if the defending king reaches the corner, or "
"the square in front of the pawn, it is a draw. There is no side to go "
"around."
msgstr ""
"O peão de torre é a exceção: se o rei defensor chega ao canto, ou à casa na "
"frente do peão, é empate. Não há lado por onde contornar."

#. Label for the read-only field describing the chosen lesson.
#: addon/globalPlugins/chessmart/graphical_interface/endgame_dialog.py:67
msgid "About this lesson"
msgstr "Sobre esta lição"

#. Spoken after the judge flagged a move in a lesson.
#: addon/globalPlugins/chessmart/virtual_chessboard/endgame_board.py:563
msgid "Backspace takes it back."
msgstr "Backspace desfaz."

#. Spoken with the moves that keep the tablebase result.
#: addon/globalPlugins/chessmart/virtual_chessboard/endgame_board.py:185
msgid "Best moves: {moves}"
msgstr "Melhores lances: {moves}"

#. Title of a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:370
msgid "Bishop against a pawn"
msgstr "Bispo contra peão"

#. First choice of position for a mate drill.
#: addon/globalPlugins/chessmart/graphical_interface/endgame_dialog.py:105
msgid "Capablanca's example"
msgstr "Exemplo do Capablanca"

#. Description of the lesson on queen against pawn.
#: addon/globalPlugins/chessmart/endgame/lessons.py:495
msgid ""
"Central and knight pawns lose to the queen; bishop and rook pawns draw by "
"stalemate when the attacking king is far."
msgstr ""
"Peões central e de cavalo perdem para a dama; peões de bispo e de torre "
"empatam por afogamento quando o rei atacante está longe."

#. Rule taught by a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:507
msgid ""
"Checks force the defending king in front of its pawn; each time it stands "
"there, your king gains a step. Repeat until your king arrives, then take the"
" pawn. Win."
msgstr ""
"Os xeques forçam o rei defensor a ficar na frente do próprio peão; cada vez "
"que ele fica ali, o seu rei ganha um passo. Repita até o seu rei chegar, e "
"aí tome o peão. Ganha."

#. Label for the optional clock of the mate drills.
#: addon/globalPlugins/chessmart/graphical_interface/endgame_dialog.py:74
msgid "Clock for the mate drills (minutes+seconds, empty for none)"
msgstr "Relógio dos treinos de mate (minutos+segundos; vazio é sem relógio)"

#. Spoken at the end of a lesson position.
#: addon/globalPlugins/chessmart/virtual_chessboard/endgame_board.py:612
msgid "Control+N goes to the next position."
msgstr "Control+N vai para a próxima posição."

#. Spoken when the lesson question was answered correctly.
#: addon/globalPlugins/chessmart/virtual_chessboard/endgame_board.py:502
msgid "Correct: {result}."
msgstr "Certo: {result}."

#. Rule taught by a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:324
msgid ""
"Count: how many moves the pawn needs to promote, how many the king needs to "
"arrive. The rook stops the pawn from behind and the king comes: here it "
"arrives in time. Win."
msgstr ""
"Conte: quantos lances o peão leva para coroar, quantos o rei leva para "
"chegar. A torre segura o peão por trás e o rei vem: aqui ele chega a tempo. "
"Ganha."

#. Title of a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:394
msgid "Doubled pawns win"
msgstr "Peões dobrados ganham"

#. Button that opens the tablebase download dialog.
#: addon/globalPlugins/chessmart/graphical_interface/endgame_dialog.py:83
msgid "Download &tablebases..."
msgstr "Baixar &tablebases..."

#. Shown after the user cancels the tablebase download.
#: addon/globalPlugins/chessmart/graphical_interface/tablebase_dialog.py:173
msgid ""
"Download cancelled. What arrived is kept; the next download resumes from "
"there."
msgstr ""
"Download cancelado. O que chegou fica guardado; o próximo download continua "
"dali."

#. Announced when the tablebase download starts.
#: addon/globalPlugins/chessmart/graphical_interface/tablebase_dialog.py:136
msgid "Downloading {count} files, {size}."
msgstr "Baixando {count} arquivos, {size}."

#. One of the answers to "win or draw?".
#: addon/globalPlugins/chessmart/endgame/judge.py:195
msgid "Draw"
msgstr "Empate"

#. Rule taught by a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:228
msgid ""
"Draw a square from the pawn to its promotion rank. If the defending king, on"
" its move, cannot step into that square, the pawn promotes on its own. The "
"kings do not matter: just count."
msgstr ""
"Trace um quadrado do peão até a fileira de coroação. Se o rei defensor, na "
"vez dele, não consegue entrar nesse quadrado, o peão coroa sozinho. Os reis "
"não importam: é só contar."

#. Tablebase verdict for a cursed win or blessed loss.
#: addon/globalPlugins/chessmart/endgame/judge.py:161
msgid "Draw by the fifty-move rule: the mate exists, but it takes too long."
msgstr ""
"Empate pela regra dos cinquenta lances: o mate existe, mas demora demais."

#. Tablebase verdict.
#: addon/globalPlugins/chessmart/endgame/judge.py:163
msgid "Draw."
msgstr "Empate."

#. Rule taught by a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:420
msgid ""
"Each side has a passed pawn and each king can stop the other's: count the "
"squares and nobody promotes. Draw. Do not run the pawn before counting."
msgstr ""
"Cada lado tem um peão passado e cada rei alcança o do outro: conte os "
"quadrados e ninguém coroa. Empate. Não corra com o peão antes de contar."

#. Title of the tablebase download dialog.
#: addon/globalPlugins/chessmart/graphical_interface/tablebase_dialog.py:41
#: addon/globalPlugins/chessmart/graphical_interface/tablebase_dialog.py:165
#: addon/globalPlugins/chessmart/graphical_interface/tablebase_dialog.py:186
msgid "Endgame Tablebases"
msgstr "Tablebases de finais"

#. Description of the rook mate lesson.
#: addon/globalPlugins/chessmart/endgame/lessons.py:88
msgid ""
"Keep your king on the same rank or file as the other king, next to the rook,"
" and push the king to the edge. Under 20 moves."
msgstr ""
"Mantenha o seu rei na mesma fileira ou coluna do rei adversário, ao lado da "
"torre, e empurre o rei para a borda. Menos de 20 lances."

#. Rule taught by a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:144
msgid ""
"King and pawn against king: the king goes in front of the pawn, and the pawn"
" moves last. Run the king up before touching the pawn."
msgstr ""
"Rei e peão contra rei: o rei vai na frente do peão, e o peão anda por "
"último. Suba com o rei antes de tocar no peão."

#. Title of a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:262
msgid "King behind the pawn"
msgstr "Rei atrás do peão"

#. Title of a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:274
msgid "King on the sixth in front of the pawn"
msgstr "Rei na sexta na frente do peão"

#. Title of a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:250
msgid "King two squares in front of the pawn"
msgstr "Rei duas casas na frente do peão"

#. Rule taught by a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:156
msgid ""
"Kings face to face with one square between them: that is the opposition, and"
" whoever has to move loses it. White to move here cannot get past: draw."
msgstr ""
"Reis frente a frente com uma casa entre eles: isso é a oposição, e quem tem "
"que mover perde ela. Brancas a jogar aqui não passam: empate."

#. Title of a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:346
msgid "Knight against a pawn on the seventh"
msgstr "Cavalo contra peão na sétima"

#. Title of a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:358
msgid "Knight against a rook pawn on the seventh"
msgstr "Cavalo contra peão de torre na sétima"

#. Asked when Escape is pressed while playing out a lesson position.
#: addon/globalPlugins/chessmart/virtual_chessboard/endgame_board.py:546
msgid "Leave the lesson? This attempt will count as not held."
msgstr "Sair da lição? Esta tentativa vai contar como resultado não mantido."

#. Label for the list of endgame lessons.
#: addon/globalPlugins/chessmart/graphical_interface/endgame_dialog.py:52
msgid "Lesson"
msgstr "Lição"

#. Intro text of the endgames dialog.
#: addon/globalPlugins/chessmart/graphical_interface/endgame_dialog.py:43
msgid ""
"Lessons follow the endgame course order: first the mates, then what draws "
"and what does not. Each position asks win, draw or loss, tells the rule, and"
" is played out against the engine with the tablebase as judge."
msgstr ""
"As lições seguem a ordem dos cursos de final: primeiro os mates, depois o "
"que empata e o que não empata. Cada posição pergunta ganha, empata ou perde,"
" diz a regra, e é jogada até o fim contra a engine com a tablebase de juiz."

#. One of the answers to "win or draw?".
#: addon/globalPlugins/chessmart/endgame/judge.py:197
msgid "Loss"
msgstr "Perde"

#. Title of a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:481
msgid "Lucena: the bridge"
msgstr "Lucena: a ponte"

#. Spoken when the position is not covered by the installed tablebases.
#: addon/globalPlugins/chessmart/virtual_chessboard/endgame_board.py:163
msgid "No tablebase for this position."
msgstr "Sem tablebase para esta posição."

#. Spoken when a tablebase key is pressed and no tablebases are installed.
#: addon/globalPlugins/chessmart/virtual_chessboard/endgame_board.py:161
msgid "No tablebases installed. Download them from the Endgames dialog."
msgstr "Nenhuma tablebase instalada. Baixe no diálogo de Finais."

#. Spoken when the lesson question was answered wrongly, e.g. "No: it is a
#. draw."
#: addon/globalPlugins/chessmart/virtual_chessboard/endgame_board.py:505
msgid "No: it is a {result}."
msgstr "Não: é {result}."

#. Instruction after the question in a lesson: the position is a draw.
#: addon/globalPlugins/chessmart/endgame/lessons.py:749
msgid "Now hold the draw: play the position out against the engine."
msgstr "Agora segure o empate: jogue a posição até o fim contra a engine."

#. Instruction after the question in a lesson: the position is won.
#: addon/globalPlugins/chessmart/endgame/lessons.py:746
msgid "Now win it: play the position out against the engine."
msgstr "Agora ganhe: jogue a posição até o fim contra a engine."

#. Rule taught by a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:240
msgid ""
"One file closer and the king steps into the square: it catches the pawn. "
"Draw. Diagonal steps cost nothing, so the king moves on the diagonal."
msgstr ""
"Uma coluna mais perto e o rei entra no quadrado: alcança o peão. Empate. "
"Andar na diagonal não custa nada, então o rei anda na diagonal."

#. Rule taught by a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:336
msgid ""
"One more step for the pawn and the count turns: the king does not arrive, "
"and the rook alone must give itself up for the pawn. Draw."
msgstr ""
"Um passo a mais do peão e a conta vira: o rei não chega, e a torre sozinha "
"tem que se entregar pelo peão. Empate."

#. Spoken with the only move that keeps the tablebase result, e.g. "Only move:
#. Kd6".
#: addon/globalPlugins/chessmart/virtual_chessboard/endgame_board.py:182
msgid "Only move: {moves}"
msgstr "Único lance: {moves}"

#. Title of a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:154
msgid "Opposition: the side to move loses it"
msgstr "Oposição: quem joga perde ela"

#. Title of a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:418
msgid "Pawn against pawn, each king holds one"
msgstr "Peão contra peão, cada rei segura um"

#. Rule taught by a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:483
msgid ""
"Pawn on the seventh, your king in front of it, the defending king cut off by"
" your rook. The bridge: rook to the fourth rank, the king steps out, and "
"when the checks come the rook blocks them. Win."
msgstr ""
"Peão na sétima, o seu rei na frente dele, o rei defensor cortado pela sua "
"torre. A ponte: torre na quarta fileira, o rei sai, e quando os xeques "
"vierem a torre bloqueia. Ganha."

#. Rule taught by a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:288
msgid ""
"Pawn on the sixth with the king beside it and the move: push the pawn. The "
"defending king cannot hold the promotion square. Win."
msgstr ""
"Peão na sexta com o rei ao lado e o lance: empurre o peão. O rei defensor "
"não segura a casa de coroação. Ganha."

#. Title of a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:298
msgid "Pawn on the sixth, king beside it, Black to move"
msgstr "Peão na sexta, rei ao lado, Pretas jogam"

#. Title of a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:286
msgid "Pawn on the sixth, king beside it, White to move"
msgstr "Peão na sexta, rei ao lado, Brancas jogam"

#. Title of a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:455
msgid "Philidor: the checks from behind"
msgstr "Philidor: os xeques por trás"

#. Title of a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:442
msgid "Philidor: the rook on the third rank"
msgstr "Philidor: a torre na terceira fileira"

#. Label for the list of positions of the chosen lesson.
#: addon/globalPlugins/chessmart/graphical_interface/endgame_dialog.py:60
msgid "Position"
msgstr "Posição"

#. Title of a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:529
msgid "Queen against a bishop pawn"
msgstr "Dama contra peão de bispo"

#. Title of a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:505
msgid "Queen against a central pawn"
msgstr "Dama contra peão central"

#. Title of a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:517
msgid "Queen against a knight pawn"
msgstr "Dama contra peão de cavalo"

#. Title of a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:541
msgid "Queen against a rook pawn"
msgstr "Dama contra peão de torre"

#. Second choice of position for a mate drill.
#: addon/globalPlugins/chessmart/graphical_interface/endgame_dialog.py:107
msgid "Random position"
msgstr "Posição sorteada"

#. Spoken when a lesson position was played out keeping the theoretical
#. result.
#: addon/globalPlugins/chessmart/virtual_chessboard/endgame_board.py:597
msgid "Result held, with no slip. This one is yours."
msgstr "Resultado mantido, sem escorregar. Esta é sua."

#. Spoken when the result was kept but with slips or take-backs along the way.
#: addon/globalPlugins/chessmart/virtual_chessboard/endgame_board.py:600
msgid ""
"Result held, with {slips} slips and {takebacks} take-backs. Once more "
"without them."
msgstr ""
"Resultado mantido, com {slips} escorregões e {takebacks} lances desfeitos. "
"Mais uma vez, sem eles."

#. Description of the lesson on a piece against a pawn.
#: addon/globalPlugins/chessmart/endgame/lessons.py:312
msgid ""
"Rook against pawn is counting; the knight holds a seventh-rank pawn except "
"the rook pawn; the bishop holds from a distance."
msgstr ""
"Torre contra peão é contar; o cavalo segura o peão na sétima, menos o de "
"torre; o bispo segura de longe."

#. Title of a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:322
msgid "Rook against pawn: just counting"
msgstr "Torre contra peão: só contar"

#. Title of a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:334
msgid "Rook against pawn: one step too late"
msgstr "Torre contra peão: um passo atrasado"

#. Title of a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:190
msgid "Rook pawn: the attacking king is imprisoned"
msgstr "Peão de torre: o rei atacante preso"

#. Title of a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:178
msgid "Rook pawn: the corner draws"
msgstr "Peão de torre: o canto empata"

#. Title of a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:202
msgid "Rook pawn: the defender arrives too late"
msgstr "Peão de torre: o defensor chega tarde"

#. Rule taught by a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:168
msgid ""
"Same pieces, other side to move: now Black must step aside and White has the"
" opposition. The king walks through, and only then the pawn advances."
msgstr ""
"Mesmas peças, o outro lado a jogar: agora as Pretas têm que sair da frente e"
" as Brancas têm a oposição. O rei passa, e só depois o peão avança."

#. Note in the tablebase download dialog.
#: addon/globalPlugins/chessmart/graphical_interface/tablebase_dialog.py:97
msgid ""
"Source: the Syzygy tables mirrored by Lichess (tablebase.lichess.ovh). Each "
"file is checked before it is kept; a cancelled download resumes where it "
"stopped."
msgstr ""
"Fonte: as tabelas Syzygy espelhadas pelo Lichess (tablebase.lichess.ovh). "
"Cada arquivo é conferido antes de ficar; um download cancelado continua de "
"onde parou."

#. Message shown when the tablebases were installed.
#: addon/globalPlugins/chessmart/graphical_interface/tablebase_dialog.py:162
msgid "Tablebases up to {pieces} pieces installed. The judge is on."
msgstr "Tablebases até {pieces} peças instaladas. O juiz está ligado."

#. Shown when no tablebases are installed.
#: addon/globalPlugins/chessmart/graphical_interface/tablebase_dialog.py:33
msgid "Tablebases: none installed. The judge is silent until they are."
msgstr "Tablebases: nenhuma instalada. O juiz fica calado até instalar."

#. Shown with the installed tablebases, e.g. "Tablebases: up to 5 pieces
#. installed."
#: addon/globalPlugins/chessmart/graphical_interface/tablebase_dialog.py:35
msgid "Tablebases: up to {pieces} pieces installed."
msgstr "Tablebases: até {pieces} peças instaladas."

#. Label of the list where the user picks which tablebases to download.
#: addon/globalPlugins/chessmart/graphical_interface/tablebase_dialog.py:85
msgid "Tables to download"
msgstr "Tabelas a baixar"

#. Spoken by the tablebase judge after a move that turned a win into a draw.
#: addon/globalPlugins/chessmart/endgame/judge.py:173
msgid "That move let the win slip: the position is now a draw."
msgstr "Esse lance deixou escapar o ganho: a posição agora é empate."

#. Spoken by the tablebase judge after a move that turned a draw into a loss.
#: addon/globalPlugins/chessmart/endgame/judge.py:178
msgid "That move lost the draw: the position is now lost."
msgstr "Esse lance perdeu o empate: a posição agora está perdida."

#. Spoken by the tablebase judge after a move that turned a win into a loss.
#: addon/globalPlugins/chessmart/endgame/judge.py:176
msgid "That move turned a won position into a lost one."
msgstr "Esse lance transformou uma posição ganha em perdida."

#. Rule taught by a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:192
msgid ""
"The attacking king stuck in the corner in front of its own rook pawn cannot "
"get out: the defender only needs to guard f7 and f8. Draw."
msgstr ""
"O rei atacante preso no canto na frente do próprio peão de torre não sai: o "
"defensor só precisa guardar f7 e f8. Empate."

#. Rule taught by a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:579
msgid ""
"The bishop controls the promotion square: it takes the corner from the king,"
" and the pawn promotes. Win."
msgstr ""
"O bispo controla a casa de coroação: tira o canto do rei, e o peão coroa. "
"Ganha."

#. Rule taught by a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:567
msgid ""
"The bishop does not control the promotion square and the defending king sits"
" in the corner: nothing can push it out. Draw. Check the color of the corner"
" before trading down."
msgstr ""
"O bispo não controla a casa de coroação e o rei defensor senta no canto: "
"nada tira ele de lá. Empate. Confira a cor do canto antes de trocar peças."

#. Rule taught by a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:531
msgid ""
"The bishop pawn draws: when the queen forces the king in front, it goes to "
"the corner instead, and taking the pawn is stalemate. Draw while your king "
"is far."
msgstr ""
"O peão de bispo empata: quando a dama força o rei para a frente, ele vai "
"para o canto, e tomar o peão é afogamento. Empate enquanto o seu rei está "
"longe."

#. Rule taught by a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:360
msgid ""
"The exception: against a rook pawn the knight in the corner has no square to"
" come back to, and it falls. Lost for the knight."
msgstr ""
"A exceção: contra o peão de torre o cavalo no canto não tem casa para "
"voltar, e cai. Perdido para o cavalo."

#. Title of a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:142
msgid "The king leads"
msgstr "O rei na frente"

#. Rule taught by a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:276
msgid ""
"The king on the sixth rank in front of its pawn wins whoever is to move. "
"Step to the side, the pawn follows, and the defending king cannot cover both"
" squares."
msgstr ""
"O rei na sexta fileira na frente do próprio peão ganha seja de quem for o "
"lance. Sai para o lado, o peão segue, e o rei defensor não cobre as duas "
"casas."

#. Rule taught by a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:252
msgid ""
"The king two squares in front of its pawn wins whoever is to move: it takes "
"the opposition, or the pawn's spare move gives it back."
msgstr ""
"O rei duas casas na frente do próprio peão ganha seja de quem for o lance: "
"ele toma a oposição, ou o lance de reserva do peão devolve ela."

#. Rule taught by a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:519
msgid ""
"The knight pawn loses the same way: the king in front of the pawn gives your"
" king a step each time. Win."
msgstr ""
"O peão de cavalo perde do mesmo jeito: o rei na frente do peão dá um passo "
"ao seu rei a cada vez. Ganha."

#. Description of the lesson on rook and pawn against rook.
#: addon/globalPlugins/chessmart/endgame/lessons.py:432
msgid ""
"The most common endgame in practice. Philidor draws, a passive rook loses, "
"Lucena wins with the bridge."
msgstr ""
"O final mais comum na prática. Philidor empata, torre passiva perde, Lucena "
"ganha com a ponte."

#. Title of a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:406
msgid "The outside passed pawn"
msgstr "O peão passado afastado"

#. Rule taught by a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:408
msgid ""
"The outside passed pawn does not promote: it decoys. The defending king must"
" go and fetch it, and your king eats on the other side."
msgstr ""
"O peão passado afastado não coroa: ele distrai. O rei defensor tem que ir "
"buscá-lo, e o seu rei come do outro lado."

#. Title of a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:468
msgid "The passive rook loses"
msgstr "A torre passiva perde"

#. Rule taught by a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:457
msgid ""
"The pawn is on the sixth and the attacking king wants the sixth too: now the"
" rook checks from behind, without stopping. The king has nowhere to hide "
"from the checks. Draw."
msgstr ""
"O peão está na sexta e o rei atacante quer a sexta também: agora a torre dá "
"xeque por trás, sem parar. O rei não tem onde se esconder dos xeques. "
"Empate."

#. Description of the queen mate lesson.
#: addon/globalPlugins/chessmart/endgame/lessons.py:77
msgid ""
"The queen alone cannot mate: drive the king to the edge, bring your own king"
" up, mind the stalemate. Under 10 moves."
msgstr ""
"A dama sozinha não dá mate: leve o rei adversário à borda, suba com o seu "
"rei, cuidado com o afogamento. Menos de 10 lances."

#. Spoken when the lesson position was not held.
#: addon/globalPlugins/chessmart/virtual_chessboard/endgame_board.py:608
msgid "The result slipped. Control+R plays the same position again."
msgstr "O resultado escapou. Control+R joga a mesma posição de novo."

#. Title of a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:577
msgid "The right bishop"
msgstr "O bispo certo"

#. Rule taught by a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:470
msgid ""
"The rook on the seventh instead of the third rank, and the king in front of "
"the pawn: the attacking king reaches the sixth and it is lost. Without the "
"third rank there is no Philidor."
msgstr ""
"A torre na sétima em vez da terceira fileira, e o rei na frente do peão: o "
"rei atacante chega à sexta e está perdido. Sem a terceira fileira não existe"
" Philidor."

#. Rule taught by a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:543
msgid ""
"The rook pawn draws: the king hides in the corner in front of it and there "
"is no check that does not stalemate. Draw while your king is far."
msgstr ""
"O peão de torre empata: o rei se esconde no canto na frente dele e não há "
"xeque que não afogue. Empate enquanto o seu rei está longe."

#. Rule taught by a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:204
msgid ""
"The rook pawn wins when the defending king reaches neither the corner nor "
"the square of the pawn. Push it: count the squares first."
msgstr ""
"O peão de torre ganha quando o rei defensor não alcança nem o canto nem o "
"quadrado do peão. Empurre: conte as casas primeiro."

#. Description of the lesson on king and pawn against king.
#: addon/globalPlugins/chessmart/endgame/lessons.py:216
msgid ""
"The rule of the square, the king in front of the pawn, and the pawn on the "
"sixth: what wins, what draws, and why."
msgstr ""
"A regra do quadrado, o rei na frente do peão, e o peão na sexta: o que "
"ganha, o que empata, e por quê."

#. Title of a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:238
msgid "The rule of the square: inside"
msgstr "A regra do quadrado: dentro"

#. Title of a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:226
msgid "The rule of the square: outside"
msgstr "A regra do quadrado: fora"

#. Title of a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:166
msgid "The same position, Black to move"
msgstr "A mesma posição, Pretas jogam"

#. Description of the lesson on pawns on both sides.
#: addon/globalPlugins/chessmart/endgame/lessons.py:384
msgid ""
"The spare tempo of doubled pawns, the outside passed pawn that decoys, and "
"pawn against pawn where each king holds one."
msgstr ""
"O tempo de reserva dos peões dobrados, o peão passado afastado que distrai, "
"e peão contra peão onde cada rei segura um."

#. Title of a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:565
msgid "The wrong bishop"
msgstr "O bispo errado"

#. Description of the lesson on bishop and rook pawn.
#: addon/globalPlugins/chessmart/endgame/lessons.py:555
msgid ""
"The wrong bishop cannot win: it does not control the promotion square, and "
"the king in the corner never leaves."
msgstr ""
"O bispo errado não ganha: não controla a casa de coroação, e o rei no canto "
"nunca sai."

#. Announced when the chosen tablebases are already installed.
#: addon/globalPlugins/chessmart/graphical_interface/tablebase_dialog.py:130
msgid "These tables are already installed."
msgstr "Essas tabelas já estão instaladas."

#. Instruction after the question in a lesson: the position is lost, nothing
#. to play.
#: addon/globalPlugins/chessmart/endgame/lessons.py:751
msgid ""
"This one is lost with best play; there is nothing to play out. Control+N "
"goes on."
msgstr ""
"Esta está perdida com o melhor jogo; não há o que jogar. Control+N segue."

#. Spoken when Control+N is pressed on the last position of a lesson.
#: addon/globalPlugins/chessmart/virtual_chessboard/endgame_board.py:648
msgid "This was the last position of the lesson."
msgstr "Esta era a última posição da lição."

#. Spoken after a move was taken back in a lesson, e.g. "Took back Kd6. Your
#. move."
#: addon/globalPlugins/chessmart/virtual_chessboard/endgame_board.py:587
msgid "Took back {move}. Your move."
msgstr "Desfeito {move}. Sua vez."

#. Rule taught by a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:396
msgid ""
"Two doubled pawns win where one draws: the rear pawn is a spare tempo. When "
"the opposition is against you, move the rear pawn and it is against them."
msgstr ""
"Dois peões dobrados ganham onde um empata: o peão de trás é um tempo de "
"reserva. Quando a oposição está contra você, mova o peão de trás e ela fica "
"contra eles."

#. The smaller set of tablebases.
#: addon/globalPlugins/chessmart/graphical_interface/tablebase_dialog.py:58
msgid "Up to 4 pieces: king and pawn against king, and the elementary mates"
msgstr "Até 4 peças: rei e peão contra rei, e os mates elementares"

#. The full set of tablebases.
#: addon/globalPlugins/chessmart/graphical_interface/tablebase_dialog.py:61
msgid ""
"Up to 5 pieces: rook and pawn against rook, queen against pawn, everything "
"in the lessons"
msgstr ""
"Até 5 peças: torre e peão contra torre, dama contra peão, tudo o que há nas "
"lições"

#. One of the answers to "win or draw?".
#: addon/globalPlugins/chessmart/endgame/judge.py:193
msgid "Win"
msgstr "Ganha"

#. Description of the lesson on the king and the opposition.
#: addon/globalPlugins/chessmart/endgame/lessons.py:132
msgid ""
"With king and pawn against king the king leads, the pawn goes last. The "
"opposition decides who passes, and the rook pawn is the exception that "
"draws."
msgstr ""
"Com rei e peão contra rei o rei vai na frente, o peão por último. A oposição"
" decide quem passa, e o peão de torre é a exceção que empata."

#. Rule taught by a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:264
msgid ""
"With the king behind its pawn and the defending king in front, the attacking"
" king never gets past. Draw. This is why the king must lead."
msgstr ""
"Com o rei atrás do próprio peão e o rei defensor na frente, o rei atacante "
"nunca passa. Empate. É por isso que o rei tem que ir na frente."

#. Rule taught by a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:300
msgid ""
"Without the move it is a draw: Black plays the king in front of the pawn, "
"and after the pawn checks on the seventh the attacking king cannot support "
"it without stalemate. A pawn that checks on the seventh is the sign of a "
"draw."
msgstr ""
"Sem o lance é empate: as Pretas põem o rei na frente do peão, e depois do "
"xeque do peão na sétima o rei atacante não consegue apoiá-lo sem afogar. "
"Peão que dá xeque na sétima é sinal de empate."

#. Rule taught by a lesson position.
#: addon/globalPlugins/chessmart/endgame/lessons.py:444
msgid ""
"You defend. Keep the rook on your third rank (the sixth from the other side)"
" so the attacking king cannot cross. When the pawn reaches that rank, the "
"rook goes to the last rank and checks from behind. Draw."
msgstr ""
"Você defende. Mantenha a torre na sua terceira fileira (a sexta vista do "
"outro lado) para o rei atacante não cruzar. Quando o peão chegar a essa "
"fileira, a torre vai para a última e dá xeque por trás. Empate."

#. Tablebase verdict, e.g. "white loses: 12 moves ..." (moves the losing side
#. can hold on).
#: addon/globalPlugins/chessmart/endgame/judge.py:155
msgid "{color} loses: {moves} moves of resistance at most."
msgstr "{color} perde: no máximo {moves} lances de resistência."

#. Tablebase verdict, e.g. "white wins: 7 moves to the next capture, pawn move
#. or mate".
#: addon/globalPlugins/chessmart/endgame/judge.py:149
msgid "{color} wins: {moves} moves to the next pawn move, capture or mate."
msgstr ""
"{color} ganha: {moves} lances até o próximo lance de peão, captura ou mate."

#. One set of tablebases that is fully installed.
#: addon/globalPlugins/chessmart/graphical_interface/tablebase_dialog.py:76
msgid "{name}: {total}, installed"
msgstr "{name}: {total}, instalado"

#. One set of tablebases with its download size, e.g. "Up to 5 pieces (...):
#. 984 MB, 120 MB still to download".
#: addon/globalPlugins/chessmart/graphical_interface/tablebase_dialog.py:67
msgid "{name}: {total}, {remaining} still to download"
msgstr "{name}: {total}, faltam {remaining}"

#. Suffix of a lesson position attempted but not yet held.
#: addon/globalPlugins/chessmart/graphical_interface/endgame_dialog.py:124
msgid "{title} (not held yet)"
msgstr "{title} (ainda não mantida)"

#. Suffix of a lesson position with its streak, e.g. "The king leads (3 in a
#. row)".
#: addon/globalPlugins/chessmart/graphical_interface/endgame_dialog.py:122
msgid "{title} ({streak} in a row)"
msgstr "{title} ({streak} seguidas)"

#. The lesson question, e.g. "The king leads. You play white, white to move.
#. Win, draw or loss for white?".
#: addon/globalPlugins/chessmart/virtual_chessboard/endgame_board.py:480
msgid ""
"{title}. You play {color}, {turn} to move. Win, draw or loss for {color}?"
msgstr ""
"{title}. Você joga de {color}, {turn} a jogar. Ganha, empata ou perde para "
"{color}?"

#. Button that copies the study log to the clipboard.
#: addon/globalPlugins/chessmart/graphical_interface/study_dialog.py:57
msgid "&Copy to clipboard"
msgstr "&Copiar para a área de transferência"

#. Menu item that opens the study log.
#: addon/globalPlugins/chessmart/__init__.py:72
msgid "&My Study..."
msgstr "&Meu estudo..."

#. Heading of the daily part of the study log.
#: addon/globalPlugins/chessmart/graphical_interface/study_dialog.py:86
msgid "By day"
msgstr "Por dia"

#. Announced after the study log was copied.
#: addon/globalPlugins/chessmart/graphical_interface/study_dialog.py:98
msgid "Copied."
msgstr "Copiado."

#. Heading of the lessons part of the study log.
#: addon/globalPlugins/chessmart/graphical_interface/study_dialog.py:90
msgid "Endgame lessons: how far you go"
msgstr "Lições de final: até onde você vai"

#. One day's endgame work in the study log, e.g. "endgames: 4 positions, 3
#. held, 18 min".
#: addon/globalPlugins/chessmart/study_log.py:174
msgid "endgames: {n} positions, {held} held, {minutes} min"
msgstr "finais: {n} posições, {held} mantidas, {minutes} min"

#. Shown when every lesson is firm.
#: addon/globalPlugins/chessmart/study_log.py:236
msgid "Every lesson is firm. Time for the next book."
msgstr "Todas as lições estão firmes. Hora do próximo livro."

#. Explains what "firm" means in the study log.
#: addon/globalPlugins/chessmart/study_log.py:242
msgid ""
"Firm means held {streak} times in a row, question answered right and result "
"kept without a slip."
msgstr ""
"Firme quer dizer mantida {streak} vezes seguidas: pergunta certa e resultado"
" mantido sem escorregar."

#. Menu item that opens the study log.
#: addon/globalPlugins/chessmart/__init__.py:73
msgid ""
"How much and how you studied, by day, and how far the endgame lessons go"
msgstr ""
"Quanto e como você estudou, por dia, e até onde as lições de final vão"

#. Period choices of the study log.
#: addon/globalPlugins/chessmart/graphical_interface/study_dialog.py:41
msgid "Last 30 days"
msgstr "Últimos 30 dias"

#. Period choices of the study log.
#: addon/globalPlugins/chessmart/graphical_interface/study_dialog.py:40
msgid "Last 7 days"
msgstr "Últimos 7 dias"

#. Title of the study log dialog.
#: addon/globalPlugins/chessmart/graphical_interface/study_dialog.py:28
msgid "My Study"
msgstr "Meu estudo"

#. Shown in the study log when nothing was recorded in the period.
#: addon/globalPlugins/chessmart/study_log.py:157
msgid "Nothing recorded in the last {days} days."
msgstr "Nada registrado nos últimos {days} dias."

#. Label of the period selector in the study log.
#: addon/globalPlugins/chessmart/graphical_interface/study_dialog.py:33
msgid "Period"
msgstr "Período"

#. Label of the read-only text with the study log.
#: addon/globalPlugins/chessmart/graphical_interface/study_dialog.py:50
msgid "Study log"
msgstr "Registro de estudo"

#. One day's tactics in the study log, e.g. "tactics: 3 puzzles, 2 solved, 25
#. min".
#: addon/globalPlugins/chessmart/study_log.py:165
msgid "tactics: {n} puzzles, {solved} solved, {minutes} min"
msgstr "tática: {n} puzzles, {solved} certos, {minutes} min"

#. Shown when the study log could not be read.
#: addon/globalPlugins/chessmart/graphical_interface/study_dialog.py:82
msgid "The history could not be read."
msgstr "Não foi possível ler o histórico."

#. Period choices of the study log.
#: addon/globalPlugins/chessmart/graphical_interface/study_dialog.py:39
msgid "Today"
msgstr "Hoje"

#. Where the player is in the endgame lessons, e.g. "You are at: 3. King and
#. pawn against king."
#: addon/globalPlugins/chessmart/study_log.py:239
msgid "You are at: {lesson}."
msgstr "Você está em: {lesson}."

#. Closing line of the study log, e.g. "6 days with study in the last 7, 210
#. min in all."
#: addon/globalPlugins/chessmart/study_log.py:191
msgid "{active} days with study in the last {days}, {minutes} min in all."
msgstr "{active} dias com estudo nos últimos {days}, {minutes} min ao todo."

#. One day in the study log, e.g. "2026-09-19: tactics: ...; endgames: ...
#. Total 43 min."
#: addon/globalPlugins/chessmart/study_log.py:183
msgid "{day}: {parts}. Total {minutes} min."
msgstr "{day}: {parts}. Total {minutes} min."

#. A lesson whose positions are all firm, e.g. "2. The king and the
#. opposition: firm, 6 of 6."
#: addon/globalPlugins/chessmart/study_log.py:213
msgid "{lesson}: firm, {firm} of {total}."
msgstr "{lesson}: firme, {firm} de {total}."

#. A lesson not started yet.
