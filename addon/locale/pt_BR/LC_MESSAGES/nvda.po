#. Button that opens a file picker for the tactics database.
#: addon/globalPlugins/chessmart/graphical_interface/tactics_setup.py:79
msgid "&Browse..."
msgstr "&Procurar..."

#. Button that cancels the download or closes the dialog.
#: addon/globalPlugins/chessmart/graphical_interface/download_dialog.py:102
#: addon/globalPlugins/chessmart/graphical_interface/tablebase_dialog.py:113
msgid "&Cancel"
msgstr "&Cancelar"

#. Name of the add-on submenu under NVDA's Tools menu.
#: addon/globalPlugins/chessmart/__init__.py:125
msgid "&Chessboard"
msgstr "&Chessmart"

#. Button that starts the download of the puzzle database. Button that starts
#. the tablebase download.
#: addon/globalPlugins/chessmart/graphical_interface/download_dialog.py:99
#: addon/globalPlugins/chessmart/graphical_interface/download_dialog.py:173
#: addon/globalPlugins/chessmart/graphical_interface/tablebase_dialog.py:111
msgid "&Download"
msgstr "&Baixar"

#. Menu item that opens the new game dialog, and its help text.
#: addon/globalPlugins/chessmart/__init__.py:54
msgid "&New Game..."
msgstr "&Nova partida..."

#. Menu item that starts a puzzle with the saved training setup, and its help
#. text.
#: addon/globalPlugins/chessmart/__init__.py:62
msgid "&Random Puzzle"
msgstr "Puzzle &aleatório"

#. Menu item that replays a PGN file, and its help text.
#: addon/globalPlugins/chessmart/__init__.py:78
msgid "&Replay PGN File..."
msgstr "&Reproduzir arquivo PGN..."

#. Checkbox that stores the current setup as the default.
#: addon/globalPlugins/chessmart/graphical_interface/tactics_dialog.py:75
msgid "&Save training setup as default"
msgstr "&Salvar esta configuração de treino como padrão"

#. Menu item that opens the add-on settings, and its help text.
#: addon/globalPlugins/chessmart/__init__.py:117
msgid "&Settings..."
msgstr "&Configurações..."

#. Menu item that opens the tactics trainer, and its help text.
#: addon/globalPlugins/chessmart/__init__.py:58
msgid "&Tactics..."
msgstr "&Táticas..."

#. Description of the middle challenge level.
#: addon/globalPlugins/chessmart/trainer.py:205
msgid "A comfortable middle ground for daily training."
msgstr "Um meio-termo confortável para o treino diário."

#. Shown when a newer puzzle database than the installed one is available.
#: addon/globalPlugins/chessmart/graphical_interface/download_dialog.py:182
msgid "A newer Lichess base of {when} is available."
msgstr "Há uma base do Lichess mais nova, de {when}."

#. Name of the challenge level that follows the user's rating. The explanation
#. is appended automatically.
#: addon/globalPlugins/chessmart/trainer.py:236
msgid "Adaptive"
msgstr "Adaptativo"

#. Shown when no theme filter is applied.
#: addon/globalPlugins/chessmart/graphical_interface/tactics_setup.py:226
#: addon/globalPlugins/chessmart/graphical_interface/tactics_setup.py:234
msgid "All themes"
msgstr "Todos os temas"

#. Move notation style that reads files with the names used by blind players
#. (anna, bella, cesar...).
#: addon/globalPlugins/chessmart/notation.py:40
msgid "Anna: knight felix 3"
msgstr "Anna: cavalo felix 3"

#. Name of a chess variant (Antichess: whoever loses all pieces wins).
#: addon/globalPlugins/chessmart/game_elements.py:143
msgid "Anti chess"
msgstr "Antixadrez"

#. Spoken in place of the drop sign "@" when reading a move. Spoken between an
#. attacking piece and its square, e.g. "knight, at, f3".
#: addon/globalPlugins/chessmart/notation.py:134
#: addon/globalPlugins/chessmart/virtual_chessboard/announcements.py:65
msgid "at"
msgstr "em"

#. Square where a capture happened, e.g. "at f3".
#: addon/globalPlugins/chessmart/spoken_messages.py:161
#: addon/globalPlugins/chessmart/spoken_messages.py:221
#: addon/globalPlugins/chessmart/spoken_messages.py:234
msgid "at {square}"
msgstr "em {square}"

#. Name of a chess variant (captures explode).
#: addon/globalPlugins/chessmart/game_elements.py:145
msgid "Atomic"
msgstr "Atômico"

#. Spoken before the list of pieces attacking a square.
#: addon/globalPlugins/chessmart/virtual_chessboard/announcements.py:55
msgid "Attacked by"
msgstr "Atacada por"

#. Shown when a puzzle database is available and none is installed.
#: addon/globalPlugins/chessmart/graphical_interface/download_dialog.py:179
msgid "Available: Lichess base of {when}."
msgstr "Disponível: base do Lichess de {when}."

#. Tab bar action that returns to the board. Action in the endgame toolbar.
#. Button of the tactics actions bar.
#: addon/globalPlugins/chessmart/virtual_chessboard/analysis_board.py:278
#: addon/globalPlugins/chessmart/virtual_chessboard/editor_board.py:135
#: addon/globalPlugins/chessmart/virtual_chessboard/endgame_board.py:265
#: addon/globalPlugins/chessmart/virtual_chessboard/endgame_board.py:462
#: addon/globalPlugins/chessmart/virtual_chessboard/puzzle_board.py:135
msgid "Back to board"
msgstr "Voltar ao tabuleiro"

#. Piece name used when reading moves aloud. Name of the chess piece.
#: addon/globalPlugins/chessmart/notation.py:77
#: addon/globalPlugins/chessmart/spoken_messages.py:76
msgid "bishop"
msgstr "bispo"

#. Side choice in the new game dialog: play the black pieces.
#: addon/globalPlugins/chessmart/game_elements.py:172
msgid "Black"
msgstr "Pretas"

#. The side that plays the white pieces. The side that plays the black pieces.
#: addon/globalPlugins/chessmart/spoken_messages.py:89
msgid "black"
msgstr "pretas"

#. Name of the clock of the black side.
#: addon/globalPlugins/chessmart/time_control.py:40
msgid "Black Clock"
msgstr "Relógio das pretas"

#. Result of a PGN game.
#: addon/globalPlugins/chessmart/pgn.py:99
msgid "Black won"
msgstr "Pretas venceram"

#. Time control choice: 3 minutes per player, 2 seconds added per move.
#: addon/globalPlugins/chessmart/game_elements.py:83
msgid "Blitz (3+2)"
msgstr "Blitz (3+2)"

#. Time control choice: 5 minutes per player, 5 seconds added per move.
#: addon/globalPlugins/chessmart/game_elements.py:81
msgid "Blitz (5+5)"
msgstr "Blitz (5+5)"

#. Role of the chessboard control, spoken by the screen reader.
#: addon/globalPlugins/chessmart/virtual_chessboard/base.py:333
msgid "Board"
msgstr "Tabuleiro"

#. Time control choice: 1 minute per player, no increment.
#: addon/globalPlugins/chessmart/game_elements.py:87
msgid "Bullet (1+0)"
msgstr "Bullet (1+0)"

#. Time control choice: 2 minutes per player, 2 seconds added per move.
#: addon/globalPlugins/chessmart/game_elements.py:85
msgid "Bullet (2+2)"
msgstr "Bullet (2+2)"

#. Button that clears the selected themes.
#: addon/globalPlugins/chessmart/graphical_interface/tactics_setup.py:149
msgid "C&lear themes"
msgstr "&Limpar temas"

#. Spoken between the capturing piece and the captured piece.
#: addon/globalPlugins/chessmart/spoken_messages.py:158
#: addon/globalPlugins/chessmart/spoken_messages.py:219
msgid "captured"
msgstr "capturou"

#. Spoken after the color that castled.
#: addon/globalPlugins/chessmart/spoken_messages.py:168
msgid "castled"
msgstr "fizeram roque"

#. Label for the challenge level combo box.
#: addon/globalPlugins/chessmart/graphical_interface/tactics_dialog.py:65
msgid "Challenge level"
msgstr "Nível de desafio"

#. Part of the session description, e.g. "Challenge: Intermediate".
#: addon/globalPlugins/chessmart/training_session.py:249
msgid "Challenge: {level}"
msgstr "Desafio: {level}"

#. Spoken after a move that gives check.
#: addon/globalPlugins/chessmart/notation.py:144
msgid "check"
msgstr "xeque"

#. Spoken after a move that gives checkmate. How a game ended, spoken at game
#. over.
#: addon/globalPlugins/chessmart/notation.py:147
#: addon/globalPlugins/chessmart/spoken_messages.py:96
#: addon/globalPlugins/chessmart/virtual_chessboard/analysis_board.py:695
msgid "checkmate"
msgstr "mate"

#. Name of the chessboard control, spoken by the screen reader.
#: addon/globalPlugins/chessmart/virtual_chessboard/base.py:335
msgid "Chess"
msgstr "Xadrez"

#. Name of a chess variant (Fischer random chess).
#: addon/globalPlugins/chessmart/game_elements.py:141
msgid "Chess 960"
msgstr "Xadrez 960"

#. Title of the chessboard window.
#: addon/globalPlugins/chessmart/chessboard.py:51
msgid "Chess Board"
msgstr "Tabuleiro de xadrez"

#. File type filter of the PGN save dialog.
#: addon/globalPlugins/chessmart/virtual_chessboard/board_files.py:36
msgid "Chess Game *.pgn | *.pgn"
msgstr "Partida de xadrez *.pgn | *.pgn"

#. Accessible name of the chessboard window. Title of the Chessboard settings
#. dialog.
#: addon/globalPlugins/chessmart/chessboard.py:55
#: addon/globalPlugins/chessmart/graphical_interface/settings_panel.py:35
msgid "Chessboard"
msgstr "Chessmart"

#. Title of the tactics window before a puzzle is loaded.
#: addon/globalPlugins/chessmart/virtual_chessboard/puzzle_board.py:271
msgid "Chessboard Tactics"
msgstr "Táticas do Chessmart"

#. Summary/title for this add-on Category of the add-on's scripts in the Input
#. Gestures dialog.
#: buildVars.py:25 addon/globalPlugins/chessmart/__init__.py:596
msgid "Chessmart"
msgstr "Chessmart"

#. Error shown when no database is set yet.
#: addon/globalPlugins/chessmart/graphical_interface/tactics_setup.py:328
msgid "Choose a tactics database before selecting themes."
msgstr "Escolha uma base de táticas antes de selecionar temas."

#. Prompt in the theme picker, when choosing the saved default themes.
#: addon/globalPlugins/chessmart/graphical_interface/settings_panel.py:109
msgid ""
"Choose one or more Lichess themes to use in the custom default trainer plan."
msgstr ""
"Escolha um ou mais temas do Lichess para o plano de treino personalizado "
"padrão."

#. Prompt in the theme picker dialog.
#: addon/globalPlugins/chessmart/graphical_interface/tactics_setup.py:215
msgid "Choose one or more Lichess themes to use in the custom training plan."
msgstr ""
"Escolha um ou mais temas do Lichess para o plano de treino personalizado."

#. Description of the training plan where the user picks the themes.
#: addon/globalPlugins/chessmart/trainer.py:180
msgid "Choose the exact Lichess themes you want to include in the session."
msgstr "Escolha exatamente os temas do Lichess que quer incluir na sessão."

#. Intro text of the new game dialog.
#: addon/globalPlugins/chessmart/graphical_interface/new_game_dialog.py:38
msgid "Choose the play mode, starting position, and time control."
msgstr "Escolha o modo de jogo, a posição inicial e o controle de tempo."

#. Time control choice: 90 minutes per player, 30 seconds added per move.
#: addon/globalPlugins/chessmart/game_elements.py:75
msgid "Classical  (90+30)"
msgstr "Clássica (90+30)"

#. Name of the complete puzzle database.
#: addon/globalPlugins/chessmart/graphical_interface/download_dialog.py:37
msgid "Complete"
msgstr "Completa"

#. Intro text of the Chessboard settings dialog.
#: addon/globalPlugins/chessmart/graphical_interface/settings_panel.py:52
msgid ""
"Configure the default trainer plan used when you open Chessboard tactics."
msgstr ""
"Configure o plano de treino padrão usado ao abrir as táticas do Chessmart."

#. Part of the puzzle shortcuts announcement.
#: addon/globalPlugins/chessmart/virtual_chessboard/puzzle_board.py:314
msgid "Control+Enter twice to play the expected move."
msgstr "Control+Enter duas vezes joga o lance esperado."

#. Part of the puzzle shortcuts announcement.
#: addon/globalPlugins/chessmart/virtual_chessboard/puzzle_board.py:308
msgid "Control+F1 for puzzle details."
msgstr "Control+F1 para os detalhes do puzzle."

#. Part of the puzzle shortcuts announcement.
#: addon/globalPlugins/chessmart/virtual_chessboard/puzzle_board.py:299
msgid "Control+H for a hint."
msgstr "Control+H para uma dica."

#. Part of the puzzle shortcuts announcement.
#: addon/globalPlugins/chessmart/virtual_chessboard/puzzle_board.py:302
msgid "Control+N for the next puzzle."
msgstr "Control+N para o próximo puzzle."

#. Spoken after a puzzle ends: how to go on.
#: addon/globalPlugins/chessmart/virtual_chessboard/puzzle_board.py:449
msgid "Control+N loads another puzzle."
msgstr "Control+N carrega outro puzzle."

#. Spoken after a puzzle ends: how to try it again.
#: addon/globalPlugins/chessmart/virtual_chessboard/puzzle_board.py:455
msgid "Control+R restarts this one."
msgstr "Control+R reinicia este."

#. Part of the puzzle shortcuts announcement.
#: addon/globalPlugins/chessmart/virtual_chessboard/puzzle_board.py:305
msgid "Control+R to restart this puzzle."
msgstr "Control+R para reiniciar este puzzle."

#. Title of the error shown when themes cannot be read.
#: addon/globalPlugins/chessmart/graphical_interface/tactics_setup.py:346
msgid "Could Not Load Themes"
msgstr "Não foi possível carregar os temas"

#. Spoken when saving is refused because NVDA runs in secure mode.
#: addon/globalPlugins/chessmart/virtual_chessboard/base.py:253
#: addon/globalPlugins/chessmart/virtual_chessboard/base.py:259
msgid "Could not save game. NVDA running in secure mode."
msgstr "Não foi possível salvar a partida. O NVDA está em modo seguro."

#. Spoken after the first wrong move of a puzzle: the rating is settled, the
#. puzzle goes on.
#: addon/globalPlugins/chessmart/virtual_chessboard/puzzle_board.py:363
msgid "Counted as a failure. Keep going to learn the solution."
msgstr "Contado como erro. Continue para aprender a solução."

#. Name of a chess variant (captured pieces can be dropped back).
#: addon/globalPlugins/chessmart/game_elements.py:155
msgid "Crazy house"
msgstr "Crazyhouse"

#. Time control choice: the user types their own, e.g. 10+5.
#: addon/globalPlugins/chessmart/game_elements.py:89
#: addon/globalPlugins/chessmart/graphical_interface/new_game_dialog.py:95
msgid "Custom Time Control"
msgstr "Controle de tempo personalizado"

#. Part of the session status: all puzzles ever tried.
#: addon/globalPlugins/chessmart/virtual_chessboard/puzzle_board.py:738
msgid "Database history: {solved} solved out of {total} attempts."
msgstr "Histórico da base: {solved} resolvidos em {total} tentativas."

#. Label of the list where the user picks which database to download.
#: addon/globalPlugins/chessmart/graphical_interface/download_dialog.py:81
msgid "Database to download"
msgstr "Base para baixar"

#. Label for the default challenge level combo box.
#: addon/globalPlugins/chessmart/graphical_interface/settings_panel.py:65
msgid "Default challenge level"
msgstr "Nível de desafio padrão"

#. Label for the default themes field.
#: addon/globalPlugins/chessmart/graphical_interface/settings_panel.py:69
msgid "Default themes"
msgstr "Temas padrão"

#. Label for the default training plan combo box.
#: addon/globalPlugins/chessmart/graphical_interface/settings_panel.py:63
msgid "Default training plan"
msgstr "Plano de treino padrão"

#. Move notation style that describes moves in full sentences.
#: addon/globalPlugins/chessmart/notation.py:30
msgid "Descriptive: white knight from g1 to f3"
msgstr "Descritiva: cavalo das brancas de g1 para f3"

#. Button that opens the dialog to download or update the puzzle database.
#: addon/globalPlugins/chessmart/graphical_interface/tactics_setup.py:81
msgid "Do&wnload or update..."
msgstr "Bai&xar ou atualizar..."

#. Shown after the user cancels the puzzle database download.
#: addon/globalPlugins/chessmart/graphical_interface/download_dialog.py:339
msgid "Download cancelled."
msgstr "Download cancelado."

#. Announced after the download, while the list of puzzle themes is being
#. prepared.
#: addon/globalPlugins/chessmart/graphical_interface/download_dialog.py:305
msgid "Download complete. Preparing the theme catalog, this takes a moment..."
msgstr ""
"Download concluído. Preparando o catálogo de temas, isso leva um momento..."

#. Announced when the puzzle database download starts.
#: addon/globalPlugins/chessmart/graphical_interface/download_dialog.py:246
msgid "Downloading {name}, {size}."
msgstr "Baixando {name}, {size}."

#. Spoken when the player takes back a draw offer.
#: addon/globalPlugins/chessmart/virtual_chessboard/user_driven.py:108
msgid "Draw offer withdrawn"
msgstr "Oferta de empate retirada"

#. Spoken when the player offers a draw.
#: addon/globalPlugins/chessmart/virtual_chessboard/user_driven.py:111
msgid "Draw offered."
msgstr "Empate oferecido."

#. Name of the menu that asks which piece to drop (Crazyhouse).
#: addon/globalPlugins/chessmart/virtual_chessboard/user_driven.py:231
msgid "Drop Piece. Select piece type:"
msgstr "Colocar peça. Escolha o tipo de peça:"

#. A piece dropped on the board (Crazyhouse), e.g. "dropped a knight".
#: addon/globalPlugins/chessmart/spoken_messages.py:178
#: addon/globalPlugins/chessmart/spoken_messages.py:233
msgid "dropped a {piece}"
msgstr "colocaram {piece}"

#. Spoken after an en passant capture.
#: addon/globalPlugins/chessmart/virtual_chessboard/base.py:569
msgid "en passant"
msgstr "en passant"

#. Button of the new game dialog that opens the engine options.
#: addon/globalPlugins/chessmart/graphical_interface/new_game_dialog.py:102
msgid "Engine &Options..."
msgstr "&Opções do motor..."

#. Title of the engine options dialog.
#: addon/globalPlugins/chessmart/graphical_interface/new_game_dialog.py:219
msgid "Engine Options"
msgstr "Opções do motor"

#. Label of the engine strength field, in Elo points.
#: addon/globalPlugins/chessmart/graphical_interface/new_game_dialog.py:229
msgid "Engine Strength (ELO Rating)"
msgstr "Força do motor (rating Elo)"

#. Label of the engine thinking time field.
#: addon/globalPlugins/chessmart/graphical_interface/new_game_dialog.py:236
msgid "Engine Thinking Time (in seconds)"
msgstr "Tempo de reflexão do motor (em segundos)"

#. Part of the session status: the themes and levels in use; "none" when there
#. are none.
#: addon/globalPlugins/chessmart/virtual_chessboard/puzzle_board.py:743
msgid "Filters: {filters}."
msgstr "Filtros: {filters}."

#. Completes the rating report, e.g. "Rating 1450, from 40 rated attempts".
#: addon/globalPlugins/chessmart/virtual_chessboard/puzzle_board.py:535
msgid "from {count} rated attempts"
msgstr "em {count} tentativas valendo rating"

#. Origin of a move, spoken after the piece, e.g. "from g1".
#: addon/globalPlugins/chessmart/spoken_messages.py:149
msgid "from {square}"
msgstr "de {square}"

#. Window title when the game ended in a draw.
#: addon/globalPlugins/chessmart/virtual_chessboard/base.py:418
msgid "Game Drawn"
msgstr "Partida empatada"

#. Result of a PGN game.
#: addon/globalPlugins/chessmart/pgn.py:102
msgid "Game ended in a draw"
msgstr "Partida terminou empatada"

#. Spoken when the game ended in a draw.
#: addon/globalPlugins/chessmart/virtual_chessboard/base.py:424
msgid "Game is drawn"
msgstr "Partida empatada"

#. Result of a PGN game that has no result yet.
#: addon/globalPlugins/chessmart/pgn.py:90
msgid "Game not finished"
msgstr "Partida não terminada"

#. Window title when a game has ended.
#: addon/globalPlugins/chessmart/virtual_chessboard/base.py:394
msgid "Game Over"
msgstr "Fim de partida"

#. Window title when a game was lost on time, e.g. "Game Over: Time Forfeit -
#. white is the winner".
#: addon/globalPlugins/chessmart/virtual_chessboard/base.py:431
msgid "Game Over: Time Forfeit - {color} is the winner"
msgstr "Fim de partida: derrota por tempo - {color} venceram"

#. Window title and message when a game stopped because of an error.
#: addon/globalPlugins/chessmart/virtual_chessboard/base.py:449
msgid "Game terminated due to an error"
msgstr "Partida encerrada por um erro"

#. The puzzle goal; {color} is white or black.
#: addon/globalPlugins/chessmart/virtual_chessboard/puzzle_board.py:598
msgid "Goal: find the best continuation for {color}."
msgstr "Objetivo: encontre a melhor continuação para as {color}."

#. Spoken after a correct move in a puzzle that is not finished yet.
#: addon/globalPlugins/chessmart/virtual_chessboard/puzzle_board.py:379
msgid "Good move."
msgstr "Bom lance."

#. Button of the tactics actions bar.
#: addon/globalPlugins/chessmart/virtual_chessboard/puzzle_board.py:127
msgid "Hint"
msgstr "Dica"

#. Third hint of a puzzle: the destination square.
#: addon/globalPlugins/chessmart/virtual_chessboard/puzzle_board.py:682
msgid "Hint: the move ends on {square}."
msgstr "Dica: o lance termina em {square}."

#. Second hint of a puzzle: the square the piece moves from.
#: addon/globalPlugins/chessmart/virtual_chessboard/puzzle_board.py:678
msgid "Hint: the move starts from {square}."
msgstr "Dica: o lance começa em {square}."

#. First hint of a puzzle: its tactical themes.
#: addon/globalPlugins/chessmart/virtual_chessboard/puzzle_board.py:671
msgid "Hint: themes include {themes}."
msgstr "Dica: os temas incluem {themes}."

#. Part of the puzzle details: hints used in this puzzle.
#: addon/globalPlugins/chessmart/virtual_chessboard/puzzle_board.py:716
msgid "Hints here: {count}."
msgstr "Dicas neste puzzle: {count}."

#. Part of the session status: hints asked in the whole session.
#: addon/globalPlugins/chessmart/puzzle_attempt.py:125
msgid "Hints in the session: {count}."
msgstr "Dicas na sessão: {count}."

#. Name of a chess variant (white has a horde of pawns).
#: addon/globalPlugins/chessmart/game_elements.py:151
msgid "Horde"
msgstr "Horda"

#. Play mode choice in the new game dialog.
#: addon/globalPlugins/chessmart/game_elements.py:45
msgid "Human versus computer"
msgstr "Humano contra computador"

#. Play mode choice in the new game dialog: two people at the same keyboard.
#: addon/globalPlugins/chessmart/game_elements.py:43
msgid "Human versus human"
msgstr "Humano contra humano"

#. Spoken when the requested move is not legal.
#: addon/globalPlugins/chessmart/virtual_chessboard/analysis_board.py:342
#: addon/globalPlugins/chessmart/virtual_chessboard/base.py:473
msgid "Illegal move"
msgstr "Lance ilegal"

#. Shown when a puzzle database exists but carries no version information.
#: addon/globalPlugins/chessmart/graphical_interface/download_dialog.py:118
msgid "Installed: a puzzle database of unknown version."
msgstr "Instalada: uma base de puzzles de versão desconhecida."

#. Shown when no puzzle database is installed yet.
#: addon/globalPlugins/chessmart/graphical_interface/download_dialog.py:120
msgid "Installed: none. Tactics need a puzzle database to work."
msgstr "Instalada: nenhuma. As táticas precisam de uma base de puzzles."

#. Describes the installed puzzle database, e.g. "Installed: Light, 745,164
#. puzzles, Lichess base of 2026-09."
#: addon/globalPlugins/chessmart/graphical_interface/download_dialog.py:125
msgid "Installed: {tier}, {count:,} puzzles, Lichess base of {when}."
msgstr "Instalada: {tier}, {count:,} puzzles, base do Lichess de {when}."

#. Title of the error about an invalid starting position.
#: addon/globalPlugins/chessmart/graphical_interface/new_game_dialog.py:144
msgid "Invalid FEN String"
msgstr "FEN inválido"

#. Title of the error about an invalid time control.
#: addon/globalPlugins/chessmart/graphical_interface/endgame_dialog.py:157
#: addon/globalPlugins/chessmart/graphical_interface/new_game_dialog.py:132
msgid "Invalid Time Control String"
msgstr "Controle de tempo inválido"

#. Piece name used when reading moves aloud. Name of the chess piece.
#: addon/globalPlugins/chessmart/notation.py:81
#: addon/globalPlugins/chessmart/spoken_messages.py:82
msgid "king"
msgstr "rei"

#. Name of a chess variant (bring the king to the centre).
#: addon/globalPlugins/chessmart/game_elements.py:147
msgid "King of the hill"
msgstr "Rei da colina"

#. King-side castling. Queen-side castling.
#: addon/globalPlugins/chessmart/spoken_messages.py:171
