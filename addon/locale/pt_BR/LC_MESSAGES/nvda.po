msgstr "Xadrez"

#: addon/globalPlugins/chessmart/game_elements.py:137
msgid "Chess 960"
msgstr "Xadrez 960"

#. Title of the chessboard window.
#: addon/globalPlugins/chessmart/chessboard.py:51
msgid "Chess Board"
