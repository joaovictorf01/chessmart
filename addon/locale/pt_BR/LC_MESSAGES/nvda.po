#. Description of the varied training plan.
#: addon/globalPlugins/chessmart/trainer.py:277
msgid ""
"A broad spread across the tactical motif families: material, mating, "
"sacrifice, defence and conversion."
msgstr ""
"Um apanhado amplo das famílias de motivos táticos: material, mate, "
"sacrifício, defesa e conversão."

#. Description of the middle challenge level.
#: addon/globalPlugins/chessmart/trainer.py:309
msgid "A comfortable middle ground for daily training."
msgstr "Um meio-termo confortável para o treino diário."

#. Shown when a newer puzzle database than the installed one is available.
#: addon/globalPlugins/chessmart/graphical_interface/download_dialog.py:158
msgid "A newer Lichess base of {when} is available."
msgstr "Há uma base do Lichess mais nova, de {when}."

#. Name of the challenge level that follows the user's rating.
#: addon/globalPlugins/chessmart/trainer.py:325
msgid "Adaptive"
msgstr "Adaptativo"

#. Shown when no theme filter is applied. Name of the training plan that
#. applies no theme filter.
#: addon/globalPlugins/chessmart/graphical_interface/tactics_setup.py:216
#: addon/globalPlugins/chessmart/graphical_interface/tactics_setup.py:229
#: addon/globalPlugins/chessmart/trainer.py:283
msgid "All themes"
msgstr "Todos os temas"

#. Move notation style that reads files with the names used by blind players
#. (anna, bella, cesar...).
#: addon/globalPlugins/chessmart/notation.py:38
