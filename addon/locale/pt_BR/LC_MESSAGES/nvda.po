msgstr "xeque"

#: addon/globalPlugins/chessmart/graphical_interface/download_dialog.py:69
msgid "Checking for the latest puzzle database..."
msgstr "Verificando a base de puzzles mais recente..."

#. Spoken after a move that gives checkmate.
#: addon/globalPlugins/chessmart/notation.py:133
msgid "checkmate"
msgstr "mate"

#. Name of the chessboard control, spoken by the screen reader.
#: addon/globalPlugins/chessmart/virtual_chessboard/base.py:295
