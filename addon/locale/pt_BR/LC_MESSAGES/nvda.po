#. Spoken after the color that castled.
#: addon/globalPlugins/chessmart/spoken_messages.py:148
msgid "castled"
msgstr "fizeram roque"

#. Name of the hardest fixed challenge level.
#: addon/globalPlugins/chessmart/trainer.py:319
