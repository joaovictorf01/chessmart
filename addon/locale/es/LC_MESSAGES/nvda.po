"Checking for the latest puzzle database. Please wait: the choices and the "
"Download button come alive when the list arrives."
msgstr ""
"Buscando la base de problemas más reciente. Espera: las opciones y el botón "
"Descargar se activan cuando llegue la lista."

#. Shown when the list of available puzzle databases could not be downloaded;
#. {reason} is the technical error.
#: addon/globalPlugins/chessStudy/graphical_interface/download_dialog.py:154
msgid ""
"Could not reach the download server. Check your internet connection and try "
"again. Details: {reason}"
msgstr ""
"No se pudo conectar con el servidor de descarga. Comprueba tu conexión a "
"internet e inténtalo de nuevo. Detalle: {reason}"

#. Spoken when the chosen PGN file cannot be read, followed by the error.
#: addon/globalPlugins/chessStudy/__init__.py:623
msgid "Could not read the PGN file. Details: {error}"
msgstr "No se pudo leer el archivo PGN. Detalle: {error}"

#. Spoken after Backspace removed a move, e.g. "took back e4". Spoken after
#. Backspace took a move back in a PGN replay, e.g. "Took back Nf3".
#: addon/globalPlugins/chessStudy/virtual_chessboard/analysis_board.py:502
#: addon/globalPlugins/chessStudy/virtual_chessboard/pgn_player.py:92
