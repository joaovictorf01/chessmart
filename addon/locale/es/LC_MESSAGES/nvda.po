msgstr "&Finales..."

#. Menu item that opens the study log.
#: addon/globalPlugins/chessStudy/__init__.py:72
msgid "&My Study..."
msgstr "&Mi estudio..."

#. Menu item that opens the new game dialog, and its help text.
#: addon/globalPlugins/chessStudy/__init__.py:54
msgid "&New Game..."
msgstr "&Nueva partida..."

#. Menu item that starts a puzzle with the saved training setup, and its help
#. text.
#: addon/globalPlugins/chessStudy/__init__.py:62
