msgstr "Mate del triángulo"

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:117
msgid ""
"Two bishops on adjacent diagonals mate a king blocked by its own pieces."
msgstr ""
"Dos alfiles en diagonales adyacentes dan mate a un rey bloqueado por sus "
"propias piezas."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:71
msgid ""
"Two bishops on crossing diagonals mate a king blocked by its own pieces."
msgstr ""
"Dos alfiles en diagonales que se cruzan dan mate a un rey bloqueado por sus "
"propias piezas."

#. Rule taught by a lesson position.
#: addon/globalPlugins/chessStudy/endgame/lessons.py:412
msgid ""
"Two doubled pawns win where one draws: the rear pawn is a spare tempo. When "
"the opposition is against you, move the rear pawn and it is against them."
msgstr ""
"Dos peones doblados ganan donde uno entabla: el peón de atrás es un tempo de"
" reserva. Cuando la oposición está en tu contra, mueve el peón de atrás y "
"pasa a estar en contra de ellos."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:241
msgid "Two moves to win."
msgstr "Dos jugadas para ganar."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:120
msgid "Two pieces give check at once, so the king has to move."
msgstr "Dos piezas dan jaque a la vez, así que el rey tiene que moverse."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:67
msgid "Two rooks on the seventh rank mate the castled king."
msgstr "Dos torres en la séptima fila dan mate al rey enrocado."

#. Move notation style using origin and destination squares.
#: addon/globalPlugins/chessStudy/notation.py:34
msgid "UCI: g1f3"
msgstr "UCI: g1f3"

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:273
