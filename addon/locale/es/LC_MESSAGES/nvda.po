#: addon/globalPlugins/chessStudy/virtual_chessboard/engine_actions.py:68
msgid "The engine is still thinking"
msgstr "El motor todavía está pensando"

#. What the engine preferred, e.g. "The engine preferred e4, white slightly
#. better, plus 0.5.". The engine's move at a critical moment, e.g. "The
#. engine preferred Nf3, equal, plus 0.1.".
#: addon/globalPlugins/chessStudy/virtual_chessboard/engine_actions.py:288
#: addon/globalPlugins/chessStudy/virtual_chessboard/review_actions.py:261
msgid "The engine preferred {move}, {evaluation}."
msgstr "El motor prefería {move}, {evaluation}."

#. Spoken by Control+E when every move of the engine's line is already
#. recorded.
#: addon/globalPlugins/chessStudy/virtual_chessboard/engine_actions.py:334
msgid "The engine's line is already recorded here."
msgstr "La línea del motor ya está registrada aquí."

#. Engine verdict on a move: the engine's own choice.
#: addon/globalPlugins/chessStudy/analysis_words.py:92
msgid "the engine's move"
msgstr "la jugada del motor"

#. Spoken when moves were played, taken back or promoted while the review ran.
#: addon/globalPlugins/chessStudy/virtual_chessboard/review_actions.py:148
msgid "The game changed during the review. F7 reviews it again."
msgstr "La partida cambió durante la revisión. F7 la revisa de nuevo."

#. Spoken by Alt+Page Down when the reviewed moves were changed since the
#. review.
#: addon/globalPlugins/chessStudy/virtual_chessboard/review_actions.py:234
msgid "The game changed since the review. F7 reviews it again."
msgstr "La partida cambió desde la revisión. F7 la revisa de nuevo."

#. Spoken by "Play from here" on a checkmate or stalemate.
#: addon/globalPlugins/chessStudy/virtual_chessboard/analysis_board.py:348
msgid "The game is over in this position: there is nothing to play."
msgstr "La partida terminó en esta posición: no hay nada que jugar."

#. Position editor check: a check no legal move could have given.
#: addon/globalPlugins/chessStudy/position_editor.py:142
msgid "The king is in check from more pieces than a move can give."
msgstr "El rey está en jaque de más piezas de las que una jugada puede dar."

#. Position editor check: the side not to move is in check.
#: addon/globalPlugins/chessStudy/position_editor.py:138
msgid "The side that is not to move is in check."
msgstr "El bando que no tiene el turno está en jaque."

#. Error when Random Puzzle finds no puzzle database.
#: addon/globalPlugins/chessStudy/__init__.py:228
msgid ""
"The tactics database was not found. Choose a valid database in Chess Study "
"settings first."
msgstr ""
"No se encontró la base de táctica. Primero elige una base válida en las "
"opciones de Chess Study."

#. Spoken by F7 when the game has no moves to review.
#: addon/globalPlugins/chessStudy/virtual_chessboard/review_actions.py:94
msgid "There are no moves to review."
msgstr "No hay jugadas que revisar."

#. Position editor check: more than one king of a colour.
#: addon/globalPlugins/chessStudy/position_editor.py:122
msgid "There is more than one king of the same colour."
msgstr "Hay más de un rey del mismo color."

#. Position editor check: no black king on the board.
#: addon/globalPlugins/chessStudy/position_editor.py:120
msgid "There is no black king."
msgstr "No hay rey negro."

#. Position editor check: no white king on the board.
#: addon/globalPlugins/chessStudy/position_editor.py:118
msgid "There is no white king."
msgstr "No hay rey blanco."

#. Spoken when E is pressed on a checkmate or stalemate.
#: addon/globalPlugins/chessStudy/virtual_chessboard/engine_actions.py:75
#: addon/globalPlugins/chessStudy/virtual_chessboard/engine_actions.py:208
msgid "There is nothing to evaluate: the game is over in this position."
msgstr "No hay nada que evaluar: la partida terminó en esta posición."

#. Spoken when the engine starts the long think (E pressed twice).
#: addon/globalPlugins/chessStudy/virtual_chessboard/engine_actions.py:83
#: addon/globalPlugins/chessStudy/virtual_chessboard/engine_actions.py:90
msgid "Thinking longer, {seconds} seconds"
msgstr "Pensando más, {seconds} segundos"

#. Spoken by T when the game carries no clock (entered by hand, or an old
#. PGN).
#: addon/globalPlugins/chessStudy/virtual_chessboard/analysis_board.py:685
msgid "This game has no clock. Games imported from Lichess have one."
msgstr ""
"Esta partida no tiene reloj. Las partidas importadas de Lichess sí lo "
"tienen."

#. Spoken after Control+P made the current variation the main line.
#: addon/globalPlugins/chessStudy/virtual_chessboard/analysis_board.py:570
msgid "This variation is now the main line"
msgstr "Esta variante es ahora la línea principal"

#. Tab bar action on the analysis board, with its key.
#: addon/globalPlugins/chessStudy/virtual_chessboard/analysis_board.py:255
msgid "Threat: what the other side would play, X"
msgstr "Amenaza: lo que jugaría el otro bando, X"

#. The threat found by X, e.g. "Threat: Qxf7, white mates in 1.".
#: addon/globalPlugins/chessStudy/virtual_chessboard/engine_actions.py:233
msgid "Threat: {move}, {evaluation}."
msgstr "Amenaza: {move}, {evaluation}."

#. Shown when the date typed in the save dialog is not valid.
#: addon/globalPlugins/chessStudy/graphical_interface/record_dialog.py:76
msgid "Type the date as year-month-day, for example {example}."
msgstr "Escribe la fecha como año-mes-día, por ejemplo {example}."

#. Result choice when saving a game: unknown or unfinished.
#: addon/globalPlugins/chessStudy/graphical_interface/record_dialog.py:32
msgid "Unfinished or unknown (*)"
msgstr "Sin terminar o desconocido (*)"

#. Board editor check, e.g. "Valid position, white to move.".
#: addon/globalPlugins/chessStudy/virtual_chessboard/editor_board.py:254
msgid "Valid position, {color} to move."
msgstr "Posición válida, mueven las {color}."

#. Board editor check: a legal position that is already checkmate.
#: addon/globalPlugins/chessStudy/virtual_chessboard/editor_board.py:248
msgid "Valid position: checkmate."
msgstr "Posición válida: jaque mate."

#. Board editor check: a legal position that is already stalemate.
#: addon/globalPlugins/chessStudy/virtual_chessboard/editor_board.py:251
msgid "Valid position: stalemate."
msgstr "Posición válida: ahogado."

#. Spoken before a move that enters a variation already recorded.
#: addon/globalPlugins/chessStudy/virtual_chessboard/analysis_board.py:406
#: addon/globalPlugins/chessStudy/virtual_chessboard/analysis_board.py:438
msgid "variation"
msgstr "variante"

#. Label of the review option: what the engine says at a critical moment.
#: addon/globalPlugins/chessStudy/graphical_interface/review_dialog.py:64
msgid "What the engine &reveals"
msgstr "Lo que el motor &revela"

#. Piece name in the position editor.
#: addon/globalPlugins/chessStudy/position_editor.py:162
msgid "white bishop"
msgstr "alfil blanco"

#. Position editor check.
#: addon/globalPlugins/chessStudy/position_editor.py:124
msgid "White has more than eight pawns."
msgstr "Las blancas tienen más de ocho peones."

#. Position editor check.
#: addon/globalPlugins/chessStudy/position_editor.py:130
msgid "White has more than sixteen pieces."
msgstr "Las blancas tienen más de dieciséis piezas."

#. Piece name in the position editor.
#: addon/globalPlugins/chessStudy/position_editor.py:156
msgid "white king"
msgstr "rey blanco"

#. Piece name in the position editor.
#: addon/globalPlugins/chessStudy/position_editor.py:164
msgid "white knight"
msgstr "caballo blanco"

#. A castling right in the board editor.
#: addon/globalPlugins/chessStudy/virtual_chessboard/editor_board.py:50
msgid "white long castling"
msgstr "enroque largo de las blancas"

#. Piece name in the position editor.
#: addon/globalPlugins/chessStudy/position_editor.py:166
msgid "white pawn"
msgstr "peón blanco"

#. Piece name in the position editor.
#: addon/globalPlugins/chessStudy/position_editor.py:158
msgid "white queen"
msgstr "dama blanca"

#. Piece name in the position editor.
#: addon/globalPlugins/chessStudy/position_editor.py:160
msgid "white rook"
msgstr "torre blanca"

#. A castling right in the board editor.
#: addon/globalPlugins/chessStudy/virtual_chessboard/editor_board.py:48
msgid "white short castling"
msgstr "enroque corto de las blancas"

#. Result choice when saving a game: white won.
#: addon/globalPlugins/chessStudy/graphical_interface/record_dialog.py:26
msgid "White won (1-0)"
msgstr "Ganaron las blancas (1-0)"

#. Tab bar action on the analysis board, with its key.
#: addon/globalPlugins/chessStudy/virtual_chessboard/analysis_board.py:279
msgid "Write a comment, C"
msgstr "Escribir un comentario, C"

#. After a game review, e.g. "Your accuracy 96 percent, opponent 87.".
#: addon/globalPlugins/chessStudy/analysis_words.py:165
msgid "Your accuracy {mine} percent, opponent {theirs}."
msgstr "Tu precisión {mine} por ciento, rival {theirs}."

#. Spoken after switching a castling right, e.g. "white short castling:
#. allowed".
#: addon/globalPlugins/chessStudy/virtual_chessboard/editor_board.py:216
msgid "{castling}: allowed"
msgstr "{castling}: permitido"

#. Spoken after switching a castling right, e.g. "white short castling:
#. allowed".
#: addon/globalPlugins/chessStudy/virtual_chessboard/editor_board.py:216
msgid "{castling}: not allowed"
msgstr "{castling}: no permitido"

#. Spoken when a castling right is asked for while king or rook is not on its
#. square.
#: addon/globalPlugins/chessStudy/virtual_chessboard/editor_board.py:208
msgid ""
"{castling}: not possible, the king or the rook is not on its starting square"
msgstr ""
"{castling}: imposible, el rey o la torre no está en su casilla inicial"

#. Spoken after flipping the analysis board, e.g. "black at the bottom".
#. Spoken after flipping the board, e.g. "black at the bottom".
#: addon/globalPlugins/chessStudy/virtual_chessboard/analysis_board.py:357
#: addon/globalPlugins/chessStudy/virtual_chessboard/editor_board.py:234
msgid "{color} at the bottom"
msgstr "las {color} abajo"

#. Engine evaluation, e.g. "black clearly better, minus 1.4".
#: addon/globalPlugins/chessStudy/analysis_words.py:83
msgid "{color} clearly better, {pawns}"
msgstr "clara ventaja de las {color}, {pawns}"

#. Engine evaluation: a forced mate, e.g. "white mates in 3".
#: addon/globalPlugins/chessStudy/analysis_words.py:69
msgid "{color} mates in {moves}"
msgid_plural "{color} mates in {moves}"
msgstr[0] "las {color} dan mate en {moves}"
msgstr[1] "las {color} dan mate en {moves}"

#. Engine evaluation, e.g. "white slightly better, plus 0.5".
#: addon/globalPlugins/chessStudy/analysis_words.py:81
msgid "{color} slightly better, {pawns}"
msgstr "ligera ventaja de las {color}, {pawns}"

#. Spoken after switching whose move it is, e.g. "black to move".
#: addon/globalPlugins/chessStudy/virtual_chessboard/editor_board.py:200
msgid "{color} to move"
msgstr "mueven las {color}"

#. Engine evaluation, e.g. "white winning, plus 4.2".
#: addon/globalPlugins/chessStudy/analysis_words.py:85
msgid "{color} winning, {pawns}"
msgstr "ventaja decisiva de las {color}, {pawns}"

#. Part of the clock summary, e.g. "white: never under a minute".
#: addon/globalPlugins/chessStudy/analysis_words.py:133
msgid "{color}: never under a minute"
msgstr "{color}: nunca por debajo de un minuto"

#. Clock summary of a side whose moves carry no clock, e.g. "white: no clock".
#: addon/globalPlugins/chessStudy/analysis_words.py:128
msgid "{color}: no clock"
msgstr "{color}: sin reloj"

#. Part of the clock summary, e.g. "black: under a minute from move 34".
#: addon/globalPlugins/chessStudy/analysis_words.py:137
msgid "{color}: under a minute from move {move}"
msgstr "{color}: menos de un minuto desde la jugada {move}"

#. Start of the review summary, e.g. "3 critical moments:".
#: addon/globalPlugins/chessStudy/virtual_chessboard/review_actions.py:190
msgid "{count} critical moment:"
msgid_plural "{count} critical moments:"
msgstr[0] "{count} momento crítico:"
msgstr[1] "{count} momentos críticos:"

#. Spoken when the position has variations recorded besides the main
#. continuation.
#: addon/globalPlugins/chessStudy/virtual_chessboard/analysis_board.py:787
msgid "{count} variation from here"
msgid_plural "{count} variations from here"
msgstr[0] "{count} variante desde aquí"
msgstr[1] "{count} variantes desde aquí"

#. One of the engine's other candidate moves, e.g. "e4, plus 0.3".
#: addon/globalPlugins/chessStudy/virtual_chessboard/engine_actions.py:138
msgid "{move}, {pawns}"
msgstr "{move}, {pawns}"

#. Shift+E on a move that is still opening theory, e.g. "Nf3: theory, Sicilian
#. Defense, B50.".
#: addon/globalPlugins/chessStudy/virtual_chessboard/engine_actions.py:254
msgid "{move}: theory, {name}, {eco}."
msgstr "{move}: teoría, {name}, {eco}."

#. Engine review of a move, e.g. "Nf3: inaccuracy.".
#: addon/globalPlugins/chessStudy/virtual_chessboard/engine_actions.py:283
msgid "{move}: {verdict}."
msgstr "{move}: {verdict}."

#. Spoken by O after the game left theory, e.g. "Sicilian Defense, B20, out of
#. theory".
#: addon/globalPlugins/chessStudy/virtual_chessboard/analysis_board.py:709
msgid "{name}, {eco}, out of theory"
msgstr "{name}, {eco}, fuera de la teoría"

#. Spoken by O, e.g. "Sicilian Defense: Najdorf Variation, B90, still theory".
#: addon/globalPlugins/chessStudy/virtual_chessboard/analysis_board.py:706
msgid "{name}, {eco}, still theory"
msgstr "{name}, {eco}, todavía es teoría"

#. One entry of the mark menu, e.g. "dubious move, ?!, Control+6".
#: addon/globalPlugins/chessStudy/virtual_chessboard/analysis_board.py:95
msgid "{name}, {symbol}, Control+{key}"
msgstr "{name}, {symbol}, Control+{key}"

#. Game review progress, e.g. "50 percent reviewed".
#: addon/globalPlugins/chessStudy/virtual_chessboard/review_actions.py:127
msgid "{percent} percent reviewed"
msgstr "{percent} por ciento revisado"

#. One attacker of a square, e.g. "knight at f3".
#: addon/globalPlugins/chessStudy/virtual_chessboard/announcements.py:67
msgid "{piece} at {square}"
msgstr "{piece} en {square}"

#. A piece and its square in the board editor, e.g. "white king, e1".
#: addon/globalPlugins/chessStudy/virtual_chessboard/editor_board.py:172
#: addon/globalPlugins/chessStudy/virtual_chessboard/editor_board.py:182
msgid "{piece}, {square}"
msgstr "{piece}, {square}"

#. Spoken by Enter on an empty square of the board editor, e.g. "e4 empty".
#: addon/globalPlugins/chessStudy/virtual_chessboard/editor_board.py:169
msgid "{square} empty"
msgstr "{square} vacía"

#. A number of pawns with one decimal, e.g. "0.4"; use your language's decimal
#. separator.
#: addon/globalPlugins/chessStudy/analysis_words.py:53
msgid "{whole}.{tenth}"
msgstr "{whole},{tenth}"

#. what's new content for the add-on version to be shown in the add-on store
#: buildVars.py:35
msgid ""
"2.0.0: Chessmart is now Chess Study, with a new add-on ID, at the request of"
" the original author: remove Chessmart and install Chess Study; your rating,"
" history, missed puzzles, puzzle database, tablebases, settings and games "
"come along on the first start. The interface and the manual are complete in "
"Spanish. 1.2.0: Analysis board: record a game with variations, comments and "
"marks, or open a PGN; Stockfish 16 evaluation (E), the threat (X), move "
"review (Shift+E), opening names, and the Syzygy tablebases with five pieces "
"or fewer; game review (F7) with the critical moments and each player's "
"accuracy as Lichess computes it; saves by itself. Import Lichess Game with "
"the clock of every move; My Games; Board Editor; play from any position "
"against the computer, which now answers draw offers. Tactics: the puzzles "
"you missed come back for review until firm. Endgames: lesson 3b, promote and"
" mate with king and pawn. Stockfish 16 replaces Stockfish 14. The manual is "
"complete and has a Brazilian Portuguese version. 1.1.0: Endgames: mate "
"drills (queen, rook, two rooks, two bishops, and bishop and knight) against "
"the engine at full strength, and nine lessons that follow the endgame course"
" order (opposition, king and pawn, piece against pawn, pawns on both sides, "
"rook and pawn against rook, queen against pawn, bishop and rook pawn, and "
"the practical rook endings: short side, Vancura, back rank, rule of five, "
"rook behind the passed pawn): each position asks win, draw or loss, tells "
"the rule and is played out with the Syzygy tablebase as judge; tablebases up"
" to 5 pieces downloaded from the Lichess mirror; a log of every attempt. "
"1.0.2: Escape asks before leaving a game in progress and really closes the "
"board (engine, clock and online game included); an untouched puzzle no "
"longer counts as a failure; online board fixes (start, server clock, draw "
"offers, resignation, refused moves, reconnect); challenge levels and puzzle "
"themes with real names and descriptions. 1.0.1: the complete puzzle database"
" is downloaded in parts, with each part verified as it arrives and retried "
"on its own if the connection drops. 1.0.0: first public release of the "
"tactics trainer: Lichess puzzle database downloaded on demand (light or "
"complete) and updated monthly, Glicko-2 tactics rating with adaptive "
"difficulty, training plans by theme, configurable move notation "
"(descriptive, SAN, UCI, literate, NATO, anna) and Brazilian Portuguese "
"translation."
msgstr ""
"2.0.0: Chessmart ahora es Chess Study, con un nuevo identificador, a pedido "
"del autor original: elimina Chessmart e instala Chess Study; tu rating, "
"historial, problemas fallados, base de problemas, tablebases, opciones y "
"partidas vienen contigo la primera vez que se inicia. La interfaz y el "
"manual están completos en español. 1.2.0: Tablero de análisis: registra una "
"partida con variantes, comentarios y signos, o abre un PGN; evaluación de "
"Stockfish 16 (E), la amenaza (X), evaluación de la jugada (Shift+E), nombres"
" de aperturas y las tablebases Syzygy de cinco piezas o menos; revisión de "
"la partida (F7) con los momentos críticos y la precisión de cada jugador "
"calculada como en Lichess; se guarda solo. Importar partida de Lichess con "
"el reloj de cada jugada; Mis partidas; Editor de tablero; juega desde "
"cualquier posición contra la computadora, que ahora responde a las ofertas "
"de tablas. Táctica: los problemas que fallaste vuelven para repaso hasta "
"quedar firmes. Finales: lección 3b, coronar y dar mate con rey y peón. "
"Stockfish 16 reemplaza a Stockfish 14. El manual está completo y tiene una "
"versión en portugués de Brasil. 1.1.0: Finales: ejercicios de mate (dama, "
"torre, dos torres, dos alfiles, y alfil y caballo) contra el motor a plena "
"fuerza, y nueve lecciones que siguen el orden de los cursos de finales "
"(oposición, rey y peón, pieza contra peón, peones en ambos flancos, torre y "
"peón contra torre, dama contra peón, alfil y peón de torre, y los finales de"
" torre prácticos: lado corto, Vancura, última fila, regla de los cinco, "
"torre detrás del peón pasado): cada posición pregunta si se gana, se entabla"
" o se pierde, enuncia la regla y se juega hasta el final con la tablebase "
"Syzygy como juez; tablebases de hasta 5 piezas descargadas del espejo de "
"Lichess; un registro de cada intento. 1.0.2: Escape pregunta antes de salir "
"de una partida en curso y cierra de verdad el tablero (motor, reloj y "
"partida en línea incluidos); un problema sin tocar ya no cuenta como fallo; "
"correcciones del tablero en línea (inicio, reloj del servidor, ofertas de "
"tablas, abandono, jugadas rechazadas, reconexión); niveles de desafío y "
"temas de problemas con nombres y descripciones reales. 1.0.1: la base "
"completa de problemas se descarga por partes, cada parte se verifica al "
"llegar y se reintenta por separado si se cae la conexión. 1.0.0: primera "
"versión pública del entrenador de táctica: base de problemas de Lichess "
"descargada bajo demanda (ligera o completa) y actualizada cada mes, rating "
"de táctica Glicko-2 con dificultad adaptativa, planes de entrenamiento por "
"tema, notación de jugadas configurable (descriptiva, SAN, UCI, literal, "
"OTAN, anna) y traducción al portugués de Brasil."

