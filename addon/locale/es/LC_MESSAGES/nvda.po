msgstr "&Reproducir archivo PGN..."

#. Checkbox that stores the current setup as the default.
#: addon/globalPlugins/chessStudy/graphical_interface/tactics_dialog.py:75
msgid "&Save training setup as default"
msgstr "&Guardar la configuración de entrenamiento como predeterminada"

#. Menu item that opens the add-on settings, and its help text.
#: addon/globalPlugins/chessStudy/__init__.py:126
msgid "&Settings..."
msgstr "&Opciones..."

#. Menu item that opens the tactics trainer, and its help text.
#: addon/globalPlugins/chessStudy/__init__.py:58
msgid "&Tactics..."
msgstr "&Táctica..."

#. Name of the first endgame lesson (a drill).
#: addon/globalPlugins/chessStudy/endgame/lessons.py:76
msgid "1a. Mate with queen and king"
msgstr "1a. Mate con dama y rey"

#. Name of the second endgame lesson (a drill).
#: addon/globalPlugins/chessStudy/endgame/lessons.py:87
msgid "1b. Mate with rook and king"
msgstr "1b. Mate con torre y rey"

#. Name of the endgame lesson on the king and the opposition.
#: addon/globalPlugins/chessStudy/endgame/lessons.py:131
msgid "2. The king and the opposition"
msgstr "2. El rey y la oposición"

#. Name of the endgame lesson on king and pawn against king.
#: addon/globalPlugins/chessStudy/endgame/lessons.py:215
msgid "3. King and pawn against king"
msgstr "3. Rey y peón contra rey"

#. Name of the endgame lesson on a piece against a pawn.
#: addon/globalPlugins/chessStudy/endgame/lessons.py:326
msgid "4. A piece against a pawn"
msgstr "4. Una pieza contra un peón"

#. Name of the endgame lesson on pawns on both sides.
#: addon/globalPlugins/chessStudy/endgame/lessons.py:398
msgid "5. Pawns on both sides"
msgstr "5. Peones en ambos flancos"

#. Name of the endgame lesson on rook and pawn against rook.
#: addon/globalPlugins/chessStudy/endgame/lessons.py:446
msgid "6. Rook and pawn against rook"
msgstr "6. Torre y peón contra torre"

#. Name of the endgame lesson on queen against pawn.
#: addon/globalPlugins/chessStudy/endgame/lessons.py:509
msgid "7. Queen against a pawn on the seventh"
msgstr "7. Dama contra peón en séptima"

#. Name of the endgame lesson on bishop and rook pawn.
#: addon/globalPlugins/chessStudy/endgame/lessons.py:569
msgid "8. Bishop and rook pawn"
msgstr "8. Alfil y peón de torre"

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:200
msgid ""
"A bishop and a rook mate the king in the corner, with a pawn blocking its "
"escape."
msgstr ""
"Un alfil y una torre dan mate al rey en la esquina, con un peón que le "
"bloquea la salida."

#. Rule taught by a lesson position.
#: addon/globalPlugins/chessStudy/endgame/lessons.py:388
msgid ""
"A bishop that reaches the diagonal of the promotion square holds the pawn "
"from any distance. Draw."
msgstr ""
"Un alfil que llega a la diagonal de la casilla de coronación frena al peón "
"desde cualquier distancia. Tablas."

#. Description of the varied training plan.
#: addon/globalPlugins/chessStudy/trainer.py:129
msgid ""
"A broad spread across the tactical motif families: winning material, mating,"
" sacrifice and deflection, defence and quiet moves, converting an advantage."
msgstr ""
"Un recorrido amplio por las familias de motivos tácticos: ganar material, "
"dar mate, sacrificio y desviación, defensa y jugadas tranquilas, convertir "
"una ventaja."

#. Description of the middle challenge level.
#: addon/globalPlugins/chessStudy/trainer.py:205
msgid "A comfortable middle ground for daily training."
msgstr "Un término medio cómodo para el entrenamiento diario."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:145
msgid "A king with few defenders around it, open to attack."
msgstr "Un rey con pocos defensores alrededor, expuesto al ataque."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:44
msgid "A knight and a rook combine to mate the king in a corner."
msgstr ""
"Un caballo y una torre se combinan para dar mate al rey en una esquina."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:39
msgid ""
"A knight and a rook or queen trap the king between the edge of the board and"
" one of its own pieces."
msgstr ""
"Un caballo y una torre o dama atrapan al rey entre el borde del tablero y "
"una de sus propias piezas."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:250
msgid "A knight mates the king, which is boxed in by its own pieces."
msgstr "Un caballo da mate al rey, encerrado por sus propias piezas."

#. Rule taught by a lesson position.
#: addon/globalPlugins/chessStudy/endgame/lessons.py:364
msgid ""
"A knight that controls the promotion square holds a seventh-rank pawn on its"
" own: it moves away and comes back, and the pawn cannot pass. Draw."
msgstr ""
"Un caballo que controla la casilla de coronación frena solo a un peón en "
"séptima: se aleja y vuelve, y el peón no puede pasar. Tablas."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:91
msgid "A knight, helped by a rook, mates the king in the corner."
msgstr "Un caballo, con ayuda de una torre, da mate al rey en la esquina."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:231
msgid ""
"A move that neither checks nor captures, but prepares an unavoidable threat."
msgstr ""
"Una jugada que no da jaque ni captura, pero prepara una amenaza inevitable."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:83
msgid ""
"A move, often with tempo, that clears a square, file or diagonal for the "
"follow-up idea."
msgstr ""
"Una jugada, a menudo con tempo, que despeja una casilla, columna o diagonal "
"para la idea siguiente."

#. Shown when a newer puzzle database than the installed one is available.
#: addon/globalPlugins/chessStudy/graphical_interface/download_dialog.py:184
msgid "A newer Lichess base of {when} is available."
msgstr "Hay disponible una base de Lichess más nueva, de {when}."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:30
msgid "A pawn deep in enemy territory, often about to promote."
msgstr "Un peón muy adentro del campo enemigo, a menudo a punto de coronar."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:284
msgid "A piece attacks or defends a square through an enemy piece."
msgstr "Una pieza ataca o defiende una casilla a través de una pieza enemiga."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:219
msgid "A piece cannot move without exposing a more valuable piece behind it."
msgstr ""
"Una pieza no puede moverse sin exponer una pieza más valiosa detrás de ella."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:265
msgid "A piece with no safe square left to escape capture."
msgstr "Una pieza sin ninguna casilla segura para escapar de la captura."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:98
msgid "A precise move needed to avoid losing material or worse."
msgstr "Una jugada precisa, necesaria para no perder material o algo peor."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:63
msgid "A queen and a bishop mate the king on the edge of the board."
msgstr "Una dama y un alfil dan mate al rey en el borde del tablero."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:269
msgid "A queen and a rook form a triangle around the king to mate it."
msgstr ""
"Una dama y una torre forman un triángulo alrededor del rey para darle mate."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:260
msgid ""
"A queen mates the king, whose two diagonal escape squares behind it are "
"blocked by its own pieces."
msgstr ""
"Una dama da mate al rey, cuyas dos casillas de escape en diagonal, detrás de"
" él, están bloqueadas por sus propias piezas."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:124
msgid ""
"A queen next to the king mates it, with the two escape squares behind "
"blocked by its own pieces."
msgstr ""
"Una dama pegada al rey le da mate, con las dos casillas de escape de atrás "
"bloqueadas por sus propias piezas."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:209
msgid ""
"A rook and a bishop mate the king on its back rank, one of its own pieces "
"blocking the escape."
msgstr ""
"Una torre y un alfil dan mate al rey en su primera fila, con una de sus "
"propias piezas bloqueando la salida."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:281
msgid ""
"A rook and a knight, supported by a third piece, mate the king on the edge "
"of the board."
msgstr ""
"Una torre y un caballo, apoyados por una tercera pieza, dan mate al rey en "
"el borde del tablero."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:168
msgid ""
"A rook next to the king, supported by the queen, mates it inside a three by "
"three box."
msgstr ""
"Una torre pegada al rey, apoyada por la dama, le da mate dentro de una caja "
"de tres por tres."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:216
msgid ""
"A rook on the open g-file and a bishop on the long diagonal mate the king in"
" the corner."
msgstr ""
"Una torre en la columna g abierta y un alfil en la gran diagonal dan mate al"
" rey en la esquina."

#. Rule taught by a lesson position.
#: addon/globalPlugins/chessStudy/endgame/lessons.py:181
msgid ""
"A rook pawn is the exception: if the defending king reaches the corner, or "
"the square in front of the pawn, it is a draw. There is no side to go "
"around."
msgstr ""
"El peón de torre es la excepción: si el rey defensor llega a la esquina, o a"
" la casilla delante del peón, son tablas. No hay lado por donde rodear."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:153
msgid ""
"A rook, a knight and a pawn work together to mate the king, whose escape the"
" pawn cuts off."
msgstr ""
"Una torre, un caballo y un peón trabajan juntos para dar mate al rey, cuya "
"salida corta el peón."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:53
msgid ""
"A sacrifice or exchange lures an enemy piece, often the king, onto a square "
"where it can be hit."
msgstr ""
"Un sacrificio o un cambio atrae una pieza enemiga, a menudo el rey, a una "
"casilla donde puede ser golpeada."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:205
msgid "A tactic from the first phase of the game."
msgstr "Una táctica de la primera fase de la partida."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:129
msgid "A tactic from the last phase of the game."
msgstr "Una táctica de la última fase de la partida."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:196
msgid "A tactic from the second phase of the game."
msgstr "Una táctica de la segunda fase de la partida."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:245
msgid ""
"A valuable piece is attacked and, when it moves away, the piece behind it is"
" captured."
msgstr ""
"Una pieza valiosa es atacada y, cuando se aparta, se captura la pieza que "
"estaba detrás."

#. Label for the read-only field describing the chosen lesson.
#: addon/globalPlugins/chessStudy/graphical_interface/endgame_dialog.py:68
msgid "About this lesson"
msgstr "Sobre esta lección"

#. Name of the challenge level that follows the user's rating. The explanation
#. is appended automatically.
#: addon/globalPlugins/chessStudy/trainer.py:236
msgid "Adaptive"
msgstr "Adaptativo"

#. Name of the harder challenge level. The rating range is appended
#. automatically.
#: addon/globalPlugins/chessStudy/trainer.py:213
msgid "Advanced"
msgstr "Avanzado"

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:30
msgid "Advanced pawn"
msgstr "Peón avanzado"

#. Shown when no theme filter is applied.
#: addon/globalPlugins/chessStudy/graphical_interface/tactics_setup.py:226
#: addon/globalPlugins/chessStudy/graphical_interface/tactics_setup.py:234
msgid "All themes"
msgstr "Todos los temas"

#. Name of the training plan that applies no theme filter, shown in a combo
#. box.
#: addon/globalPlugins/chessStudy/trainer.py:167
msgid "All themes: no filter"
msgstr "Todos los temas: sin filtro"

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:227
msgid "An attack on the king after it castled long."
msgstr "Un ataque al rey después de enrocar largo."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:171
msgid "An attack on the king after it castled short."
msgstr "Un ataque al rey después de enrocar corto."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:48
msgid ""
"An attack on the weak pawn in front of the uncastled king, as in the fried "
"liver attack."
msgstr ""
"Un ataque al peón débil delante del rey sin enrocar, como en el ataque "
"fegatello."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:65
msgid "An endgame with only bishops and pawns."
msgstr "Un final solo con alfiles y peones."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:212
msgid "An endgame with only kings and pawns."
msgstr "Un final solo con reyes y peones."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:173
msgid "An endgame with only knights and pawns."
msgstr "Un final solo con caballos y peones."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:223
msgid "An endgame with only queens and pawns."
msgstr "Un final solo con damas y peones."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:234
msgid "An endgame with only rooks and pawns."
msgstr "Un final solo con torres y peones."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:225
msgid "An endgame with queens, rooks and pawns."
msgstr "Un final con damas, torres y peones."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:149
msgid "An undefended or poorly defended piece is free to take."
msgstr "Una pieza sin defender o mal defendida se puede tomar gratis."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:38
msgid "Anastasia's mate"
msgstr "Mate de Anastasia"

#. Move notation style that reads files with the names used by blind players
#. (anna, bella, cesar...).
#: addon/globalPlugins/chessStudy/notation.py:40
msgid "Anna: knight felix 3"
msgstr "Anna: caballo felix 3"

#. Name of a chess variant (Antichess: whoever loses all pieces wins).
#: addon/globalPlugins/chessStudy/game_elements.py:144
msgid "Anti chess"
msgstr "Antiajedrez"

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:44
msgid "Arabian mate"
msgstr "Mate árabe"

#. Spoken in place of the drop sign "@" when reading a move.
#: addon/globalPlugins/chessStudy/notation.py:134
msgid "at"
msgstr "en"

#. Square where a capture happened, e.g. "at f3". Part of a spoken move: the
#. destination, e.g. "at f7".
#: addon/globalPlugins/chessStudy/spoken_messages.py:161
#: addon/globalPlugins/chessStudy/spoken_messages.py:223
#: addon/globalPlugins/chessStudy/spoken_messages.py:238
msgid "at {square}"
msgstr "en {square}"

#. Name of a chess variant (captures explode).
#: addon/globalPlugins/chessStudy/game_elements.py:146
msgid "Atomic"
msgstr "Atómico"

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:47
msgid "Attack on f2 or f7"
msgstr "Ataque a f2 o f7"

#. Name of the training plan about attacking the king, shown in a combo box.
#: addon/globalPlugins/chessStudy/trainer.py:104
msgid "Attack the king: mating nets and king hunts"
msgstr "Atacar al rey: redes de mate y cacerías del rey"

#. Spoken before the list of pieces attacking a square.
#: addon/globalPlugins/chessStudy/virtual_chessboard/announcements.py:61
msgid "Attacked by"
msgstr "Atacado por"

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:52
msgid "Attraction"
msgstr "Atracción"

#. Shown when a puzzle database is available and none is installed.
#: addon/globalPlugins/chessStudy/graphical_interface/download_dialog.py:181
msgid "Available: Lichess base of {when}."
msgstr "Disponible: base de Lichess de {when}."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:59
msgid "Back rank mate"
msgstr "Mate del pasillo"

#. Tab bar action that returns to the board. Action in the endgame toolbar.
#. Button of the tactics actions bar.
#: addon/globalPlugins/chessStudy/virtual_chessboard/analysis_board.py:305
#: addon/globalPlugins/chessStudy/virtual_chessboard/editor_board.py:135
#: addon/globalPlugins/chessStudy/virtual_chessboard/endgame_board.py:265
#: addon/globalPlugins/chessStudy/virtual_chessboard/endgame_board.py:462
#: addon/globalPlugins/chessStudy/virtual_chessboard/puzzle_board.py:154
msgid "Back to board"
msgstr "Volver al tablero"

#. Spoken after the judge flagged a move in a lesson.
#: addon/globalPlugins/chessStudy/virtual_chessboard/endgame_board.py:563
msgid "Backspace takes it back."
msgstr "Retroceso deshace la jugada."

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:63
msgid "Balestra mate"
msgstr "Mate de alfil y dama"

#. Name of the easiest challenge level. The rating range is appended
#. automatically.
#: addon/globalPlugins/chessStudy/trainer.py:190
msgid "Beginner"
msgstr "Principiante"

#. Action in the endgame toolbar.
#: addon/globalPlugins/chessStudy/virtual_chessboard/endgame_board.py:261
#: addon/globalPlugins/chessStudy/virtual_chessboard/endgame_board.py:455
msgid "Best moves"
msgstr "Mejores jugadas"

#. Spoken with the moves that keep the tablebase result.
#: addon/globalPlugins/chessStudy/virtual_chessboard/endgame_board.py:185
msgid "Best moves: {moves}"
msgstr "Mejores jugadas: {moves}"

#. Piece name used when reading moves aloud. Name of the chess piece.
#: addon/globalPlugins/chessStudy/notation.py:77
#: addon/globalPlugins/chessStudy/spoken_messages.py:76
msgid "bishop"
msgstr "alfil"

#. Title of a lesson position.
#: addon/globalPlugins/chessStudy/endgame/lessons.py:386
msgid "Bishop against a pawn"
msgstr "Alfil contra un peón"

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:65
msgid "Bishop endgame"
msgstr "Final de alfiles"

#. Side choice in the new game dialog: play the black pieces.
#: addon/globalPlugins/chessStudy/game_elements.py:173
msgid "Black"
msgstr "Negras"

#. The side that plays the white pieces. The side that plays the black pieces.
#: addon/globalPlugins/chessStudy/spoken_messages.py:89
msgid "black"
msgstr "negras"

#. Name of the clock of the black side.
#: addon/globalPlugins/chessStudy/time_control.py:40
msgid "Black Clock"
msgstr "Reloj de las negras"

#. Result of a PGN game.
#: addon/globalPlugins/chessStudy/pgn.py:99
msgid "Black won"
msgstr "Ganaron las negras"

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:67
msgid "Blind swine mate"
msgstr "Mate del cerdo ciego"

#. Time control choice: 3 minutes per player, 2 seconds added per move.
#: addon/globalPlugins/chessStudy/game_elements.py:84
msgid "Blitz (3+2)"
msgstr "Blitz (3+2)"

#. Time control choice: 5 minutes per player, 5 seconds added per move.
#: addon/globalPlugins/chessStudy/game_elements.py:82
msgid "Blitz (5+5)"
msgstr "Blitz (5+5)"

#. Role of the chessboard control, spoken by the screen reader.
#: addon/globalPlugins/chessStudy/virtual_chessboard/base.py:338
msgid "Board"
msgstr "Tablero"

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:70
msgid "Boden's mate"
msgstr "Mate de Boden"

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:79
msgid "Bring the king to safety and the rook into play."
msgstr "Pon el rey a salvo y la torre en juego."

#. Time control choice: 1 minute per player, no increment.
#: addon/globalPlugins/chessStudy/game_elements.py:88
msgid "Bullet (1+0)"
msgstr "Bala (1+0)"

#. Time control choice: 2 minutes per player, 2 seconds added per move.
#: addon/globalPlugins/chessStudy/game_elements.py:86
msgid "Bullet (2+2)"
msgstr "Bala (2+2)"

#. Heading of the daily part of the study log.
#: addon/globalPlugins/chessStudy/graphical_interface/study_dialog.py:89
msgid "By day"
msgstr "Por día"

#. Button that clears the selected themes.
#: addon/globalPlugins/chessStudy/graphical_interface/tactics_setup.py:149
msgid "C&lear themes"
msgstr "&Limpiar temas"

#. Spoken between the capturing piece and the captured piece. Part of a spoken
#. capture, e.g. "knight captured pawn at f7".
#: addon/globalPlugins/chessStudy/spoken_messages.py:158
#: addon/globalPlugins/chessStudy/spoken_messages.py:220
msgid "captured"
msgstr "capturado"

#. Name of a puzzle theme.
#: addon/globalPlugins/chessStudy/theme_names.py:75
msgid "Capturing the defender"
msgstr "Capturar al defensor"

#. Spoken after the color that castled.
